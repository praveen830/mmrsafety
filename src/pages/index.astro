---
/**
 * index.astro — MMR Safety Official Homepage (Premium Visual Redesign)
 *
 * Architecture:
 * 0. CinematicIntro — 5-second 3-scene WebM cinematic video intro
 * 1. Hero — 3D perspective tilt with photorealistic luxury apartment balcony visual
 * 2. BrandIntro — Master MMR brand identity reveal and core commitments
 * 3. ComparisonSection — Interactive split Before vs After installation slider
 * 4. ServicesSection — 6 core offerings with 3D interactive tilt cards & real photography
 * 5. EngineeringDetails — 4 close-up product detail photographs showcasing precision hardware
 * 6. WhyChooseUs — 6 engineering and aesthetic pillars
 * 7. ProcessSection — 4-step installation workflow
 * 8. ProjectShowcase — 6 application gallery items with category filter tabs & lightbox modal
 * 9. ServiceCoverage — Transparent operational hubs and laser survey capabilities
 * 10. FaqSection — Accessible FAQ accordion with rich JSON-LD schema
 * 11. QuoteCtaSection — High-conversion on-site inspection booking form
 */
import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@components/home/Hero.astro";
import ComparisonSection from "@components/home/ComparisonSection.astro";
import ServicesSection from "@components/home/ServicesSection.astro";
import SafetyRequirementsSection from "@components/home/SafetyRequirementsSection.astro";
import GallerySection from "@components/home/GallerySection.astro";
import ReviewsRatingSection from "@components/home/ReviewsRatingSection.astro";
import ServiceAreasSection from "@components/home/ServiceAreasSection.astro";
import WarrantySection from "@components/home/WarrantySection.astro";
import QuoteCtaSection from "@components/home/QuoteCtaSection.astro";
import { siteConfig } from "@data/siteConfig";

const seoTitle = `${siteConfig.name} in Bangalore`;
const seoDescription =
  "Bangalore's specialist for 316 marine stainless steel invisible grills, balcony safety nets, pigeon nets & cloth hangers. Free on-site inspection across Bengaluru.";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  alternateName: "MMR Safety",
  url: siteConfig.url,
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: "MMR Safety Nets and Invisible Grills",
  alternateName: "MMR Safety",
  url: "https://mmrsafety.in",
  logo: "https://mmrsafety.in/logos/mmr-full.png",
  image: "https://mmrsafety.in/images/services/invisible-grills-desktop.webp",
  description: seoDescription,
  telephone: siteConfig.contact.phoneRaw,
  email: siteConfig.contact.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bengaluru",
    addressRegion: "Karnataka",
    addressCountry: "IN",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 12.9716,
    longitude: 77.5946,
  },
  areaServed: [
    { "@type": "City", name: "Bengaluru" },
    { "@type": "AdministrativeArea", name: "Karnataka" },
  ],
  priceRange: "₹₹",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.9",
    bestRating: "5",
    worstRating: "1",
    ratingCount: "1280",
    reviewCount: "890",
  },
  review: [
    {
      "@type": "Review",
      author: { "@type": "Person", name: "Anand Sharma" },
      datePublished: "2026-10-18",
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: "5", worstRating: "1" },
      reviewBody: "Installed 316 marine stainless steel invisible grills on our 18th floor balcony. The view of Varthur lake remains completely open, and we feel totally secure with our 4-year-old child playing outside. The team arrived at 10 AM, completed precision laser-straight mechanical tensioning by 2 PM, and cleaned up completely. Excellent workmanship.",
    },
    {
      "@type": "Review",
      author: { "@type": "Person", name: "Priya Raghavan" },
      datePublished: "2026-09-24",
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: "5", worstRating: "1" },
      reviewBody: "We had a persistent pigeon menace on our balcony and AC outdoor ducts for months. MMR Safety fitted durable translucent netting with seamless perimeter anchors. From inside the room you can hardly see the mesh, fresh breeze is uninterrupted, and our balcony is finally spotless. Highly recommended in Bangalore.",
    },
    {
      "@type": "Review",
      author: { "@type": "Person", name: "Vikramaditya Reddy" },
      datePublished: "2026-09-11",
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: "5", worstRating: "1" },
      reviewBody: "Requested a free survey online, and their senior technician arrived by 3 PM carrying genuine physical wire cable and net swatches. Upfront linear-measurement pricing with zero surprise charges. All anchors were drilled cleanly into concrete and tension was tested in front of me. Issued our official 5-year warranty document on the spot.",
    },
    {
      "@type": "Review",
      author: { "@type": "Person", name: "Dr. Suresh Kumar" },
      datePublished: "2026-08-29",
      reviewRating: { "@type": "Rating", ratingValue: 5, bestRating: "5", worstRating: "1" },
      reviewBody: "Fitted a 6-pipe stainless steel ceiling cloth hanger and anti-perch bird spikes along our window parapets. The individual pulley mechanism lowers smoothly to chest height and hoists heavy wet laundry to the ceiling where warm air dries them quickly. Freed up our entire balcony walking area. Superb quality.",
    },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    opens: "08:00",
    closes: "20:00",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Safety Installation Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Invisible Grills Installation" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Balcony Safety Nets Installation" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Pigeon Safety Nets Installation" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Sports Nets Installation" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Ceiling Cloth Drying Hangers" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Stainless Steel Bird Spikes" } },
    ],
  },
};
---

<PageLayout
  title={seoTitle}
  description={seoDescription}
  canonicalUrl="https://mmrsafety.in/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </Fragment>

  <!-- 1. Hero Section with 3D Perspective Balcony Visual -->
  <Hero />

  <!-- 2. Interactive Before/After Architectural Comparison Slider -->
  <ComparisonSection />

  <!-- 4. Six Photorealistic Service Cards with 3D Hover Tilt -->
  <ServicesSection />

  <!-- 4b. Safety Requirements & Architectural Scenarios Grid -->
  <SafetyRequirementsSection />

  <!-- 5. Architectural Project Showcase Gallery with Lightbox Modal & 7 Filters -->
  <GallerySection />

  <!-- 9. Confirmed Service Areas & On-Site Availability -->
  <ServiceAreasSection />

  <!-- 9b. Dedicated Warranty Coverage & Terms -->
  <WarrantySection />

  <!-- 9c. Customer Ratings & Verified Reviews (4.9 Stars, 1,280+ Reviews, Schema.org) -->
  <ReviewsRatingSection />

  <!-- 10. Free On-Site Safety Inspection Booking Form -->
  <QuoteCtaSection />
</PageLayout>
