---
/**
 * [slug].astro — Streamlined Dynamic Template for All Six Individual Service Pages
 *
 * Highly visual, uncluttered, and mobile-compatible service page layout:
 * 1. Breadcrumbs Navigation
 * 2. Redesigned Service Hero (Small Title + Image with Call / Site Visit / WhatsApp buttons docked inside the bottom of the frame)
 * 3. Sub-Services & Product Variations Grid (ServiceSubServices.astro)
 * 4. Key Engineered Advantages (ServiceBenefits.astro)
 * 5. Project Showcase Gallery with Lightbox (ServiceGallery.astro)
 * 6. Related Services Cross-Links (RelatedServices.astro)
 * 7. Final Conversion CTA Banner (ServiceCta.astro)
 * 8. Interactive Free Site Visit Modal (FreeSiteVisitModal.astro)
 */
import PageLayout from "@layouts/PageLayout.astro";
import { servicesDetailData, type ServiceDetail } from "@data/servicesData";
import ServiceBreadcrumbs from "@components/services/ServiceBreadcrumbs.astro";
import ServiceHero from "@components/services/ServiceHero.astro";
import ServiceSubServices from "@components/services/ServiceSubServices.astro";
import ServiceBenefits from "@components/services/ServiceBenefits.astro";
import ServiceCta from "@components/services/ServiceCta.astro";
import RelatedServices from "@components/services/RelatedServices.astro";
import FreeSiteVisitModal from "@components/services/FreeSiteVisitModal.astro";

export async function getStaticPaths() {
  return Object.values(servicesDetailData).map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;

// Canonical URL
const canonicalUrl = `https://mmrsafety.in/services/${service.slug}/`;

// Schema.org BreadcrumbList Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://mmrsafety.in/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: "https://mmrsafety.in/services/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: service.name,
      item: canonicalUrl,
    },
  ],
};

// Schema.org Service Structured Data
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: service.name,
  name: `${service.name} Installation in Bangalore`,
  provider: {
    "@type": "HomeAndConstructionBusiness",
    name: "MMR Safety Nets and Invisible Grills",
    alternateName: "MMR Safety",
    url: "https://mmrsafety.in",
    telephone: "+91 6304433505",
    image: "https://mmrsafety.in/logos/mmr-full.png",
    priceRange: "₹₹",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bengaluru",
      addressRegion: "Karnataka",
      addressCountry: "IN",
    },
  },
  areaServed: {
    "@type": "City",
    name: "Bengaluru",
  },
  description: service.metaDescription,
  image: `https://mmrsafety.in${service.heroImage}`,
};
---

<PageLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={service.heroImage}
>
  <!-- Injected Head Metadata & Schema -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. Breadcrumb Navigation -->
  <ServiceBreadcrumbs currentName={service.name} currentSlug={service.slug} />

  <!-- 2. Hero Section (Small Title on top, Image with Buttons docked at bottom inside frame) -->
  <ServiceHero
    name={service.name}
    category={service.category}
    tagline={service.tagline}
    subtitle={service.subtitle}
    heroImage={service.heroImage}
    imageDesktop={service.imageDesktop}
    imageMobile={service.imageMobile}
    imageAlt={service.imageAlt}
    altText={service.altText}
  />

  <!-- 3. Sub-Services & Product Variations Grid -->
  <ServiceSubServices
    serviceName={service.name}
    subServices={service.subServices}
  />

  <!-- 4. Key Engineered Advantages (Visual Cards) -->
  <ServiceBenefits
    name={service.name}
    overview={service.overview}
    benefits={service.benefits}
  />

  <!-- Final Lead-Generation Enquiry CTA Banner -->
  <ServiceCta name={service.name} slug={service.slug} />

  <!-- 7. Related Services Cross-Links -->
  <RelatedServices relatedSlugs={service.relatedSlugs} />

  <!-- Global Free Site Visit Request Modal -->
  <FreeSiteVisitModal defaultService={service.name} />

</PageLayout>
