---
/**
 * index.astro — Services Hub / Catalog Page (/services/)
 *
 * Overview of all six safety solutions with direct links to each individual service page.
 */
import PageLayout from "@layouts/PageLayout.astro";
import { servicesDetailData } from "@data/servicesData";
import SafetyRequirementsSection from "@components/home/SafetyRequirementsSection.astro";
import WarrantySection from "@components/home/WarrantySection.astro";

const servicesList = Object.values(servicesDetailData);
---

<PageLayout
  title="Our Safety Services & Protection Solutions"
  description="Explore MMR Safety's full range of residential and commercial safety solutions: Invisible Grills, Balcony Safety Nets, Pigeon Nets, Sports Nets, Cloth Hangers, and Bird Spikes."
  canonicalUrl="https://mmrsafety.in/services/"
>
  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-[var(--color-soft-bg)] border-b border-[var(--color-border-light)] py-3">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-[var(--color-muted-text)]">
        <li>
          <a href="/" class="hover:text-[var(--color-primary-navy)] transition-colors">Home</a>
        </li>
        <li>
          <svg class="h-3 w-3 text-slate-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </li>
        <li class="text-[var(--color-primary-navy)] font-semibold" aria-current="page">Services</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Banner -->
  <section class="bg-gradient-to-b from-[var(--color-soft-bg)] to-white py-14 lg:py-20 border-b border-[var(--color-border-light)] text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Architectural Safety Solutions
      </span>
      <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        Engineered Protection for Modern Living
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        From transparent invisible grills to heavy-duty netting, explore our tailored residential, commercial, and sports installation solutions across Bengaluru.
      </p>
    </div>
  </section>

  <!-- 6 Services Catalog Grid -->
  <section class="bg-white py-16 lg:py-24 border-b border-[var(--color-border-light)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
        {servicesList.map((service) => (
          <article class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-soft-bg)]/50 p-6 shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:bg-white hover:shadow-2xl">
            
            <div>
              <a
                href={`/services/${service.slug}/`}
                class="block relative aspect-4/5 sm:aspect-16/10 w-full overflow-hidden rounded-2xl bg-[var(--color-soft-bg)] cursor-pointer"
                aria-label={`View ${service.name} Page`}
              >
                <picture class="h-full w-full">
                  <source media="(min-width: 768px)" srcset={service.imageDesktop} type="image/webp" />
                  <img
                    src={service.imageMobile}
                    alt={service.imageAlt || service.altText}
                    width="896"
                    height="1120"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>

              <div class="mt-6">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                  {service.category}
                </span>
                
                <h2 class="mt-1 text-2xl font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                  {service.name}
                </h2>
                
                <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                  {service.tagline}
                </p>
                
                <p class="mt-3 text-sm text-[var(--color-muted-text)] leading-relaxed line-clamp-3">
                  {service.subtitle}
                </p>

                <!-- Spec Badges -->
                <div class="mt-5 flex flex-wrap gap-2">
                  {service.specBadges.slice(0, 2).map((badge) => (
                    <span class="inline-flex items-center gap-1 rounded-md bg-white border border-[var(--color-border-light)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-primary-navy)]">
                      &bull; {badge}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Action Button -->
            <div class="mt-8 pt-4 border-t border-[var(--color-border-light)]">
              <a
                href={`/services/${service.slug}/`}
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-primary-navy)] py-3 px-5 text-xs font-bold text-white shadow-sm transition-all hover:bg-[var(--color-primary-navy-dark)] hover:shadow-md"
              >
                <span>Explore {service.name} Page</span>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Architectural Safety Requirements Grid -->
  <SafetyRequirementsSection />

  <!-- Dedicated Warranty Terms & Claim Coverage -->
  <WarrantySection />

  <!-- Quick Consultation Banner -->
  <section class="bg-[var(--color-soft-bg)] py-16 text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)]">
        Need Help Choosing the Right Safety Solution?
      </h2>
      <p class="mt-3 text-base text-[var(--color-muted-text)] leading-relaxed">
        Speak directly with our technical advisors or book a complimentary on-site inspection for your balcony or windows.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact"
          class="rounded-full bg-[var(--color-primary-navy)] px-8 py-3.5 text-sm font-bold text-white shadow-md hover:bg-[var(--color-primary-navy-dark)] transition-all"
        >
          Book Free Site Inspection
        </a>
        <a
          href="/contact"
          class="rounded-full border border-[var(--color-border)] bg-white px-7 py-3.5 text-sm font-bold text-[var(--color-primary-navy)] shadow-xs hover:bg-[var(--color-soft-bg)] transition-all"
        >
          Request Pricing &amp; Consultation
        </a>
      </div>
    </div>
  </section>
</PageLayout>
