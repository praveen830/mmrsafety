---
/**
 * projects/index.astro — Installation Showcase & Architectural Portfolio Page
 *
 * Dedicated standalone page displaying all 18 installation configurations
 * across all 6 product lines with interactive category filtering and full lightbox modal.
 */
import PageLayout from "@layouts/PageLayout.astro";
import GallerySection from "@components/home/GallerySection.astro";
import { siteConfig, getPhoneUrl, getWhatsAppUrl } from "@data/siteConfig";

const pageTitle = "Installation Showcase & Projects Gallery | MMR Safety";
const pageDescription =
  "Explore real architectural installation configurations across Bengaluru: 316-grade stainless steel invisible grills, balcony safety nets, pigeon barriers, and ceiling cloth hangers.";
const canonicalUrl = "https://mmrsafety.in/projects/";

const phoneUrl = getPhoneUrl();
const whatsappUrl = getWhatsAppUrl("Hello MMR Safety, I am browsing your Projects Showcase and would like to enquire about an on-site inspection for my home.");
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Banner -->
  <section class="relative bg-gradient-to-b from-[var(--color-soft-bg)] to-white py-14 lg:py-20 border-b border-[var(--color-border-light)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[var(--color-muted-text)] mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-primary-navy)] transition-colors">Home</a>
        <svg class="h-3 w-3 text-[var(--color-muted-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="font-semibold text-[var(--color-primary-navy)]">Installation Showcase</span>
      </nav>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
          Verified Portfolio
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
          Architectural Installation Portfolio
        </h1>
        <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
          Detailed visual configurations and technical specifications of our safety solutions across apartments, villas, and commercial properties in Bengaluru.
        </p>

        <!-- Quick CTAs -->
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={phoneUrl}
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:bg-[var(--color-primary-navy-dark)]"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
            </svg>
            <span>Call {siteConfig.contact.phone}</span>
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-xs hover:bg-[#1EBE5D]"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29"/>
            </svg>
            <span>Instant WhatsApp Enquiry</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Filterable Gallery Section -->
  <GallerySection isStandalonePage={true} />

  <!-- Bottom Site Inspection Prompt -->
  <section class="bg-[var(--color-soft-bg)] py-16 border-t border-[var(--color-border-light)]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)]">
        Want to See Physical Material Samples at Your Home?
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[var(--color-muted-text)] max-w-2xl mx-auto leading-relaxed">
        Our mobile technical team carries physical 316 SS wire cable samples, netting mesh swatches, and mounting track profiles directly to your property for live demonstrations and exact laser measurements.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-6 py-3 text-sm font-bold text-white shadow-xs hover:bg-[var(--color-primary-navy-dark)]"
        >
          <span>Schedule Free Site Measurement</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</PageLayout>
