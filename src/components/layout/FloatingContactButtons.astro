---
/**
 * FloatingContactButtons.astro
 *
 * Permanent, fixed floating contact action buttons anchored at the bottom of the viewport:
 * - Bottom Left: Direct Phone Call button (clean white circle with green phone logo, subtle shadow, and status dot)
 * - Bottom Right: Direct WhatsApp Chat button (vibrant green circle with white WhatsApp logo and ambient pulse glow)
 *
 * Perfectly responsive across mobile and desktop views, permanently accessible during scrolling.
 */
import { siteConfig, getPhoneUrl, getWhatsAppUrl } from "@data/siteConfig";

const phoneUrl = getPhoneUrl();
const whatsappUrl = getWhatsAppUrl("Hello MMR Safety, I would like to get a quote and enquiry for safety nets / invisible grills.");
---

<aside aria-label="Quick Contact Actions" class="pointer-events-none fixed inset-0 z-40 overflow-hidden">
  
  <!-- 1. Permanent Phone Call Button (Bottom-Left) -->
  <div class="pointer-events-auto absolute bottom-4 left-4 sm:bottom-6 sm:left-6 flex items-center group">
    <a
      href={phoneUrl}
      class="relative flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-white text-emerald-600 shadow-[0_4px_20px_rgba(0,0,0,0.18)] border border-slate-200/90 transition-all duration-300 hover:scale-110 hover:shadow-[0_6px_25px_rgba(0,0,0,0.22)] hover:border-emerald-500 hover:bg-emerald-50/50 active:scale-95 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      aria-label={`Call MMR Safety directly at ${siteConfig.contact.phone}`}
      title={`Call Now: ${siteConfig.contact.phone}`}
    >
      <!-- Subtle Pulse Status Ring -->
      <span class="absolute -top-0.5 -right-0.5 flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500 border-2 border-white"></span>
      </span>

      <!-- Phone Receiver SVG Icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 sm:h-7 sm:w-7 text-emerald-600 transition-transform duration-300 group-hover:rotate-12"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        />
      </svg>
    </a>

    <!-- Desktop Hover Tooltip -->
    <div class="pointer-events-none absolute left-full ml-3 hidden whitespace-nowrap rounded-full bg-[var(--color-primary-navy)] px-3.5 py-1.5 text-xs font-bold text-white shadow-lg transition-all duration-200 lg:group-hover:inline-block">
      <span>Call: {siteConfig.contact.phone}</span>
    </div>
  </div>

  <!-- 2. Permanent WhatsApp Chat Button (Bottom-Right) -->
  <div class="pointer-events-auto absolute bottom-4 right-4 sm:bottom-6 sm:right-6 flex items-center justify-end group">
    
    <!-- Desktop Hover Tooltip -->
    <div class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-[var(--color-primary-navy)] px-3.5 py-1.5 text-xs font-bold text-white shadow-lg transition-all duration-200 lg:group-hover:inline-block">
      <span>Chat on WhatsApp</span>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_4px_20px_rgba(37,211,102,0.45)] transition-all duration-300 hover:bg-[#1ebe5d] hover:scale-110 hover:shadow-[0_6px_25px_rgba(37,211,102,0.65)] active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#25D366]"
      aria-label="Chat with MMR Safety on WhatsApp"
      title="Chat with MMR Safety on WhatsApp"
    >
      <!-- Ambient Breathing Glow -->
      <span class="pointer-events-none absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-25"></span>

      <!-- Official WhatsApp SVG Icon with Phone Handset -->
      <svg
        class="h-6 w-6 sm:h-7 sm:w-7 text-white relative z-10 transition-transform duration-300 group-hover:scale-110"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
      </svg>
    </a>
  </div>

</aside>

