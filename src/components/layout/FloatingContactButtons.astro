---
/**
 * FloatingContactButtons.astro
 *
 * Permanent, vertical floating quick contact action buttons matching reference image:
 * - Positioned at the bottom-right of the viewport
 * - Vertically stacked trio:
 *     1. Top: RED circular Call Now button with white outline and white phone handset icon
 *     2. Middle: GREEN circular WhatsApp button with white outline and white WhatsApp icon
 *     3. Bottom: BLUE circular Email button with white outline and white envelope icon
 * - Includes smooth scroll-to-top button on bottom-left matching reference layout
 * - Mobile & desktop optimized with responsive sizing, touch friendliness, and desktop tooltips
 */
import { siteConfig, getPhoneUrl, getWhatsAppUrl, getEmailUrl } from "@data/siteConfig";

const phoneUrl = getPhoneUrl();
const whatsappUrl = getWhatsAppUrl("Hello MMR Safety, I would like to get a quote and enquiry for safety nets / invisible grills in Bengaluru.");
const emailUrl = getEmailUrl(undefined, "MMR Safety Inquiry - Bengaluru");
---

<!-- 1. Right-Side Bottom: Vertical Trio of Action Buttons (Red Call, Green WhatsApp, Blue Email) -->
<aside
  aria-label="Quick Contact Actions"
  class="pointer-events-none fixed right-3.5 sm:right-5 bottom-5 sm:bottom-6 z-40 flex flex-col items-center gap-2.5 sm:gap-3 select-none"
>
  
  <!-- 1. Red Phone Call Button -->
  <div class="pointer-events-auto relative group flex items-center justify-end">
    <!-- Desktop Tooltip -->
    <div
      role="tooltip"
      class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-[var(--color-primary-navy)] px-3.5 py-1 text-xs font-bold text-white shadow-lg transition-all duration-200 lg:group-hover:inline-block border border-white/20"
    >
      <span>Call: {siteConfig.contact.phone}</span>
    </div>

    <a
      href={phoneUrl}
      class="relative flex h-11 w-11 sm:h-13 sm:w-13 items-center justify-center rounded-full bg-[#e53935] text-white border-2 border-white shadow-[0_4px_16px_rgba(229,57,53,0.5)] transition-all duration-300 hover:scale-110 hover:bg-[#d32f2f] hover:shadow-[0_6px_22px_rgba(229,57,53,0.7)] active:scale-95 focus:outline-none focus:ring-2 focus:ring-red-400"
      aria-label={`Call MMR Safety directly at ${siteConfig.contact.phone}`}
      title={`Call Now: ${siteConfig.contact.phone}`}
    >
      <!-- Phone Handset SVG Icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 sm:h-6 sm:w-6 text-white transition-transform duration-300 group-hover:rotate-12"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
      </svg>
    </a>
  </div>

  <!-- 2. Green WhatsApp Button -->
  <div class="pointer-events-auto relative group flex items-center justify-end">
    <!-- Desktop Tooltip -->
    <div
      role="tooltip"
      class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-[var(--color-primary-navy)] px-3.5 py-1 text-xs font-bold text-white shadow-lg transition-all duration-200 lg:group-hover:inline-block border border-white/20"
    >
      <span>Chat on WhatsApp</span>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex h-11 w-11 sm:h-13 sm:w-13 items-center justify-center rounded-full bg-[#25D366] text-white border-2 border-white shadow-[0_4px_16px_rgba(37,211,102,0.5)] transition-all duration-300 hover:scale-110 hover:bg-[#1ebe5d] hover:shadow-[0_6px_22px_rgba(37,211,102,0.7)] active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#25D366]"
      aria-label="Chat with MMR Safety on WhatsApp"
      title="Chat with MMR Safety on WhatsApp"
    >
      <!-- Ambient Breathing Pulse Glow -->
      <span class="pointer-events-none absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-25"></span>

      <!-- Official WhatsApp SVG Icon -->
      <svg
        class="h-5 w-5 sm:h-6 sm:w-6 text-white relative z-10 transition-transform duration-300 group-hover:scale-110"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
      </svg>
    </a>
  </div>

  <!-- 3. Blue Email Button -->
  <div class="pointer-events-auto relative group flex items-center justify-end">
    <!-- Desktop Tooltip -->
    <div
      role="tooltip"
      class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-full bg-[var(--color-primary-navy)] px-3.5 py-1 text-xs font-bold text-white shadow-lg transition-all duration-200 lg:group-hover:inline-block border border-white/20"
    >
      <span>Email: {siteConfig.contact.email}</span>
    </div>

    <a
      href={emailUrl}
      class="relative flex h-11 w-11 sm:h-13 sm:w-13 items-center justify-center rounded-full bg-[#0088cc] text-white border-2 border-white shadow-[0_4px_16px_rgba(0,136,204,0.5)] transition-all duration-300 hover:scale-110 hover:bg-[#0077b5] hover:shadow-[0_6px_22px_rgba(0,136,204,0.7)] active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#0088cc]"
      aria-label={`Send email to MMR Safety at ${siteConfig.contact.email}`}
      title={`Email Us: ${siteConfig.contact.email}`}
    >
      <!-- Mail Envelope SVG Icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 sm:h-6 sm:w-6 text-white transition-transform duration-300 group-hover:scale-110"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
      </svg>
    </a>
  </div>

</aside>

<!-- 2. Bottom-Left: Subtle Scroll-to-Top Button Matching Reference Screen -->
<div class="pointer-events-none fixed left-4 bottom-5 sm:bottom-6 z-40">
  <button
    id="global-scroll-to-top-btn"
    type="button"
    class="pointer-events-auto flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl bg-[var(--color-primary-navy)]/80 backdrop-blur-md text-white border border-white/20 shadow-md transition-all duration-300 hover:bg-[var(--color-primary-navy)] hover:scale-105 active:scale-95 opacity-0 pointer-events-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]"
    aria-label="Scroll back to top of page"
    title="Back to Top"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>
</div>

<script>
  function initScrollToTop() {
    const btn = document.getElementById("global-scroll-to-top-btn");
    if (!btn) return;

    window.addEventListener("scroll", () => {
      if (window.scrollY > 300) {
        btn.classList.remove("opacity-0", "pointer-events-none");
        btn.classList.add("opacity-100", "pointer-events-auto");
      } else {
        btn.classList.remove("opacity-100", "pointer-events-auto");
        btn.classList.add("opacity-0", "pointer-events-none");
      }
    }, { passive: true });

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollToTop);
  } else {
    initScrollToTop();
  }
  document.addEventListener("astro:page-load", initScrollToTop);
</script>
