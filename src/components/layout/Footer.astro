---
/**
 * Footer.astro — Dark Architectural Theme with Highlighted Text & Netting Mesh Pattern
 *
 * Matching User's Reference Screenshot:
 * - Rich deep navy blue theme (#081423 to #0c1e36) with subtle safety-net wire mesh texture
 * - Coral/Red prominent section heading: "Our Services" (text-[#f87171] / text-red-500)
 * - Highly visible, bright WHITE text for all service links (text-white hover:text-sky-300)
 * - Complete services coverage matching reference (Balcony Safety Nets, Pets Safety Nets, Terrace Top Nets, Industrial Safety Nets, etc.)
 * - Integrated Google Rating & Reviews Trust Box (4.9 / 5.0 Stars with 1,280+ Verified Bengaluru Reviews)
 * - Authentic brand lockup, direct contact details, and copyright bar
 */
import { siteConfig, getPhoneUrl, getWhatsAppUrl, getEmailUrl } from "@data/siteConfig";

const currentYear = new Date().getFullYear();
const footerPhoneUrl = getPhoneUrl();
const footerWhatsAppUrl = getWhatsAppUrl("Hello MMR Safety, I would like to enquire about your safety nets and invisible grill services in Bengaluru.");
const footerEmailUrl = getEmailUrl(undefined, "MMR Safety - Service Inquiry");

// Comprehensive list of specialized safety net & invisible grill solutions matching reference screenshot
const primaryServices = [
  { name: "Balcony Safety Nets", href: "/services/safety-nets/" },
  { name: "Pets Safety Nets", href: "/services/safety-nets/" },
  { name: "Terrace Top Nets", href: "/services/safety-nets/" },
  { name: "Industrial Safety Nets", href: "/services/safety-nets/" },
  { name: "Building Safety Nets", href: "/services/safety-nets/" },
  { name: "Duct Area Safety Nets", href: "/services/pigeon-safety-nets/" },
  { name: "Children Safety Nets", href: "/services/safety-nets/" },
  { name: "Monkey Safety Nets", href: "/services/safety-nets/" },
  { name: "Construction Safety Nets", href: "/services/safety-nets/" },
  { name: "Swimming Pool Safety Nets", href: "/services/safety-nets/" },
  { name: "Shade Nets", href: "/services/safety-nets/" },
];

const secondaryServices = [
  { name: "Invisible Grills for Balconies", href: "/services/invisible-grills/" },
  { name: "Invisible Grills for Windows", href: "/services/invisible-grills/" },
  { name: "Pigeon Safety Nets", href: "/services/pigeon-safety-nets/" },
  { name: "Grill Balcony Safety Nets", href: "/services/invisible-grills/" },
  { name: "Mosquito Nets", href: "/services/safety-nets/" },
  { name: "Open Area Safety Nets", href: "/services/safety-nets/" },
  { name: "Staircase Safety Nets", href: "/services/safety-nets/" },
  { name: "Car Parking Safety Nets", href: "/services/safety-nets/" },
  { name: "Coconut Tree Safety Nets", href: "/services/safety-nets/" },
  { name: "Sports & Cricket Turf Nets", href: "/services/sports-nets/" },
  { name: "Ceiling Cloth Drying Hangers", href: "/services/cloth-hangers/" },
  { name: "Stainless Steel Bird Spikes", href: "/services/bird-spikes/" },
];
---

<footer class="relative bg-[#071322] border-t border-sky-900/40 text-slate-200 overflow-hidden select-none">
  
  <!-- Subtle Architectural Net Wire Mesh Pattern Overlay Matching User's Reference -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.09]"
    style="background-image: repeating-linear-gradient(45deg, #38bdf8 0, #38bdf8 1px, transparent 0, transparent 24px), repeating-linear-gradient(-45deg, #38bdf8 0, #38bdf8 1px, transparent 0, transparent 24px);"
    aria-hidden="true"
  ></div>

  <!-- Ambient Blue Corner Glow -->
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-sky-600/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-24 -left-24 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-14 pb-12 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12">
      
      <!-- Column 1: Brand, Trust Badges & Google Rating (Lg: 4 Cols) -->
      <div class="lg:col-span-4 flex flex-col justify-between space-y-6">
        <div>
          <!-- Logo with Metallic Sheen -->
          <a
            href="/"
            class="logo-sheen-container inline-block transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sky-blue)]"
            aria-label={`${siteConfig.name} - Home`}
          >
            <div class="logo-sheen-box relative">
              <img
                src="/logos/mmr-full.png"
                alt="MMR Safety Nets and Invisible Grills Official Logo"
                width="820"
                height="474"
                class="h-18 sm:h-20 w-auto filter drop-shadow-md brightness-105"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>

          <p class="mt-3 text-sm text-slate-300 font-medium leading-relaxed max-w-sm">
            Bangalore's trusted architectural safety installation specialist. Premium 316 marine-grade stainless steel invisible grills and UV-stabilized heavy-duty polymer safety nets.
          </p>

          <!-- Verified Google Customer Rating Box -->
          <div class="mt-5 rounded-2xl border border-sky-400/25 bg-[#0d2238]/80 p-4 backdrop-blur-sm shadow-inner">
            <div class="flex items-center gap-3">
              <!-- Google G Icon -->
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white shadow-sm">
                <svg class="h-6 w-6" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                </svg>
              </div>

              <div>
                <div class="flex items-center gap-1.5">
                  <span class="text-base font-black text-white">4.9 / 5.0</span>
                  <div class="flex text-amber-400 text-xs">
                    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                  </div>
                </div>
                <p class="text-[11px] font-semibold text-sky-200">
                  Google Verified Rating &bull; 1,280+ Reviews
                </p>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between border-t border-sky-400/15 pt-2.5 text-[11px]">
              <span class="text-slate-300 font-medium">✓ 100% Genuine Installations</span>
              <a href="/#ratings" class="font-bold text-[var(--color-sky-blue)] hover:text-white transition-colors underline">
                View All Reviews
              </a>
            </div>
          </div>
        </div>

        <!-- Direct Contact Summary -->
        <div class="space-y-2 text-xs text-slate-300">
          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[var(--color-sky-blue)] shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
            </svg>
            <a href={footerPhoneUrl} class="font-bold text-white hover:text-[var(--color-sky-blue)] transition-colors">
              {siteConfig.contact.phone}
            </a>
            <span class="text-[10px] text-emerald-400 font-semibold">(24/7 Response)</span>
          </p>

          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[var(--color-sky-blue)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={footerEmailUrl} class="text-slate-200 hover:text-white transition-colors">
              {siteConfig.contact.email}
            </a>
          </p>

          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-[var(--color-sky-blue)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteConfig.contact.address}</span>
          </p>
        </div>
      </div>

      <!-- Column 2 & 3: "Our Services" (Exact Reference Style: Red Heading, Highlighted White Service Text) (Lg: 5 Cols) -->
      <div class="lg:col-span-5">
        <!-- Highlighted Red Header matching user's reference image -->
        <div class="flex items-center gap-2 border-b border-white/10 pb-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ef4444] animate-pulse"></span>
          <h3 class="text-base sm:text-lg font-black uppercase tracking-wider text-[#ef4444]">
            Our Services
          </h3>
        </div>

        <!-- 2 Columns of Highlighted White Service Text -->
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-sm">
          <!-- Sub-column A -->
          <ul class="space-y-2.5">
            {
              primaryServices.map((svc) => (
                <li>
                  <a
                    href={svc.href}
                    class="group flex items-center gap-2 text-white font-medium hover:text-[var(--color-sky-blue)] transition-all duration-200"
                  >
                    <span class="h-1 w-1 rounded-full bg-sky-400 group-hover:w-2 group-hover:bg-white transition-all"></span>
                    <span class="group-hover:translate-x-0.5 transition-transform">{svc.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- Sub-column B -->
          <ul class="space-y-2.5">
            {
              secondaryServices.map((svc) => (
                <li>
                  <a
                    href={svc.href}
                    class="group flex items-center gap-2 text-white font-medium hover:text-[var(--color-sky-blue)] transition-all duration-200"
                  >
                    <span class="h-1 w-1 rounded-full bg-sky-400 group-hover:w-2 group-hover:bg-white transition-all"></span>
                    <span class="group-hover:translate-x-0.5 transition-transform">{svc.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Column 4: Quick Links & Verified Conversion CTAs (Lg: 3 Cols) -->
      <div class="lg:col-span-3 flex flex-col justify-between">
        <div>
          <h3 class="text-base font-extrabold uppercase tracking-wider text-sky-400 border-b border-white/10 pb-2.5">
            Quick Links
          </h3>
          <ul class="mt-4 space-y-2 text-sm">
            <li>
              <a href="/" class="text-slate-300 hover:text-white transition-colors">Home</a>
            </li>
            <li>
              <a href="/services/" class="text-slate-300 hover:text-white transition-colors">All Services Catalog</a>
            </li>
            <li>
              <a href="/#ratings" class="text-slate-300 hover:text-white transition-colors flex items-center gap-1.5">
                <span>Customer Reviews</span>
                <span class="rounded bg-amber-400/20 text-amber-300 px-1 py-0.2 text-[10px] font-bold">4.9★</span>
              </a>
            </li>
            <li>
              <a href="/#comparison" class="text-slate-300 hover:text-white transition-colors">Before &amp; After Comparison</a>
            </li>
            <li>
              <a href="/#warranty" class="text-slate-300 hover:text-white transition-colors">Warranty &amp; Guarantee Terms</a>
            </li>
            <li>
              <a href="/projects/" class="text-slate-300 hover:text-white transition-colors">Installation Showcase</a>
            </li>
            <li>
              <a href="/about/" class="text-slate-300 hover:text-white transition-colors">About MMR Safety</a>
            </li>
            <li>
              <a href="/contact/" class="text-slate-300 hover:text-white transition-colors">Contact &amp; Book Site Visit</a>
            </li>
          </ul>
        </div>

        <!-- Direct Instant Action Buttons in Footer -->
        <div class="mt-6 pt-5 border-t border-white/10 space-y-2.5">
          <a
            href={footerPhoneUrl}
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#e53935] px-4 py-2.5 text-xs font-bold text-white shadow-md transition-all hover:bg-[#d32f2f] hover:scale-102 active:scale-98"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
            </svg>
            <span>Call Now: +91 6304433505</span>
          </a>

          <a
            href={footerWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-4 py-2.5 text-xs font-bold text-white shadow-md transition-all hover:bg-[#1ebe5d] hover:scale-102 active:scale-98"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
            </svg>
            <span>WhatsApp: Chat with Us</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Locality Strip -->
    <div class="mt-12 border-t border-white/10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; {currentYear} {siteConfig.name}. All rights reserved.</p>
      
      <p class="text-center md:text-right">
        Serving All Bengaluru Sectors: Whitefield, Electronic City, HSR Layout, Sarjapur, Marathahalli, Bellandur, Hebbal, Kanakapura &amp; Surrounding Hubs.
      </p>
    </div>

  </div>
</footer>
