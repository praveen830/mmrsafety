---
/**
 * ServiceCoverage.astro — Service Coverage & On-Site Availability
 *
 * Transparently presents operational service hubs and on-site inspection
 * capabilities without making unconfirmed geographical or statewide claims.
 */
import { siteConfig } from "@data/siteConfig";
---

<section
  id="coverage"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-24 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="coverage-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-xs">
      <div class="grid lg:grid-cols-12 items-stretch">
        
        <!-- Left: Coverage Narrative (7 Cols) -->
        <div class="p-8 sm:p-10 lg:p-12 lg:col-span-7 flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
              Service Reach
            </span>
            <h2 id="coverage-heading" class="heading-section mt-3 text-2xl sm:text-3xl lg:text-3xl font-extrabold text-[var(--color-primary-navy)]">
              Rapid On-Site Measurement &amp; Installation
            </h2>
            <p class="mt-4 text-sm sm:text-base text-[var(--color-muted-text)] leading-relaxed">
              We provide prompt site visits for residential high-rises, gated communities, and commercial spaces. Our technician visits your property with physical cable and netting samples, takes accurate laser measurements, and provides an immediate transparent estimate.
            </p>

            <!-- 3 Service Highlights -->
            <div class="mt-8 space-y-4">
              <div class="flex items-start gap-3.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[var(--color-primary-navy)]">On-Site Physical Samples</h3>
                  <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Examine genuine high-tensile stainless steel cables and protective netting samples in person before committing.</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[var(--color-primary-navy)]">Accurate Laser Dimensions</h3>
                  <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Laser-calibrated balcony and window span measurements eliminate guesswork and guarantee exact cable tension.</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-[var(--color-primary-navy)]">Transparent Written Quotations</h3>
                  <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Clear per-square-foot breakdowns with all fittings, fasteners, and installation labour included.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Prompt -->
          <div class="mt-8 pt-6 border-t border-[var(--color-border-light)] flex flex-wrap items-center justify-between gap-4">
            <span class="text-xs text-[var(--color-muted-text)]">
              Need same-day or weekend technician scheduling?
            </span>
            <a
              href="#quote"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-primary-navy)] hover:text-[var(--color-sky-blue-dark)] transition-colors"
            >
              <span>Check Locality Availability</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Operational Map / Hub Card (5 Cols) -->
        <div class="bg-[var(--color-soft-bg)] border-t lg:border-t-0 lg:border-l border-[var(--color-border-light)] p-8 sm:p-10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
                Operational Hubs
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Active Teams
              </span>
            </div>

            <!-- Hub List -->
            <div class="mt-6 space-y-3">
              <div class="rounded-xl border border-[var(--color-border-light)] bg-white p-4 shadow-xs">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-bold text-[var(--color-primary-navy)]">Bengaluru Metropolitan Region</h4>
                  <span class="text-[10px] font-bold text-[var(--color-sky-blue-dark)] bg-[var(--color-soft-bg)] px-2 py-0.5 rounded">Primary Hub</span>
                </div>
                <p class="mt-1 text-xs text-[var(--color-muted-text)]">
                  High-rise residential corridors: Whitefield, Electronic City, Sarjapur, Hebbal, Kanakapura Road, Bellandur, Bannerghatta, North &amp; South Bengaluru.
                </p>
              </div>

              <div class="rounded-xl border border-[var(--color-border-light)] bg-white p-4 shadow-xs">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-bold text-[var(--color-primary-navy)]">Surrounding Districts &amp; Emerging Hubs</h4>
                  <span class="text-[10px] font-bold text-[var(--color-muted-text)] bg-[var(--color-soft-bg)] px-2 py-0.5 rounded">By Appointment</span>
                </div>
                <p class="mt-1 text-xs text-[var(--color-muted-text)]">
                  Scheduled multi-unit installations and gated society projects across neighbouring urban clusters.
                </p>
              </div>
            </div>

            <!-- Transparency Disclaimer -->
            <p class="mt-4 text-[11px] text-[var(--color-muted-text)] leading-relaxed italic">
              * Exact coverage and travel schedules are confirmed on inquiry based on site location and project volume.
            </p>
          </div>

          <!-- Quick Connect Button -->
          <div class="mt-8">
            <a
              href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, "")}`}
              class="flex items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-white px-5 py-3 text-xs font-bold text-[var(--color-primary-navy)] shadow-xs hover:border-[var(--color-primary-navy)] hover:bg-[var(--color-soft-bg)] transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Call Technician Helpdesk: {siteConfig.contact.phone}</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
