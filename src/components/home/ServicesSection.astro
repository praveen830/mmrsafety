---
/**
 * ServicesSection.astro — Six Distinct Architectural Service Cards
 *
 * Features:
 * - Large photorealistic architectural photographs for all six services
 * - Interactive 3D perspective card tilt with specular highlight on hover
 * - Crisp typography, key engineering tags, and direct enquiry links
 * - Clean light architectural aesthetics
 */
import { servicesData } from "@data/homeData";
import { getWhatsAppUrl } from "@data/siteConfig";
---

<section
  id="services"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="services-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Core Offerings &bull; Certified Safety
      </span>
      <h2 id="services-heading" class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        Engineered Safety &amp; Protection Solutions
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        From transparent invisible grills to heavy-duty netting, explore our tailored residential, commercial, and sports installation solutions.
      </p>
    </div>

    <!-- 6 Services Grid -->
    <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        servicesData.map((service) => (
          <article
            class="service-3d-card group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-6 shadow-sm transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-2xl focus-within:ring-2 focus-within:ring-[var(--color-sky-blue)] will-change-transform"
            aria-labelledby={`service-${service.id}`}
          >
            <!-- Top Visual Container with Photorealistic Image -->
            <div>
              <a
                href={service.href}
                class="group/img block relative aspect-16/10 w-full overflow-hidden rounded-2xl border border-[var(--color-border-light)] bg-[var(--color-soft-bg)] cursor-pointer"
                aria-label={`View ${service.name} details`}
              >
                <picture class="h-full w-full">
                  <source media="(min-width: 768px)" srcset={service.imageDesktop} type="image/webp" />
                  <img
                    src={service.imageMobile}
                    alt={service.imageAlt || service.altText || `${service.name} professional installation by MMR Safety`}
                    width="1200"
                    height="900"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>

                <!-- Ambient Vignette -->
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"
                  aria-hidden="true"
                ></div>

                <!-- Dynamic Specular Glare Layer -->
                <div
                  class="service-card-glare pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  style="background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 70%);"
                  aria-hidden="true"
                ></div>

                {service.badge && (
                  <span class="absolute top-3 right-3 rounded-full bg-white/95 backdrop-blur-md px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[var(--color-primary-navy)] border border-[var(--color-border)] shadow-xs">
                    {service.badge}
                  </span>
                )}
              </a>

              <!-- Content Area -->
              <div class="mt-6">
                <div class="flex items-center justify-between">
                  <h3 id={`service-${service.id}`} class="text-xl sm:text-2xl font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                    <a href={service.href} class="hover:underline">
                      {service.name}
                    </a>
                  </h3>
                </div>
                
                <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                  {service.tagline}
                </p>
                <p class="mt-3 text-sm text-[var(--color-muted-text)] leading-relaxed">
                  {service.description}
                </p>

                <!-- Key Features List -->
                <ul class="mt-5 space-y-2.5 border-t border-[var(--color-border-light)] pt-4 text-xs text-[var(--color-muted-text)]">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-[var(--color-sky-blue)]/20 text-[var(--color-primary-navy)] mt-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      </span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Bottom Action Row: View Details + Quick WhatsApp Button -->
            <div class="mt-6 flex items-center gap-2.5 border-t border-[var(--color-border-light)] pt-4">
              <a
                href={service.href}
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[var(--color-soft-bg)] border border-[var(--color-border)] px-4 py-3 text-xs font-bold text-[var(--color-primary-navy)] transition-all duration-200 hover:border-[var(--color-primary-navy)] hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-md focus-visible:outline-2 focus-visible:outline-[var(--color-sky-blue)]"
              >
                <span>View Details</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={getWhatsAppUrl(service.name)}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#25D366] text-white shadow-xs transition-all duration-200 hover:bg-[#1ebe5d] hover:shadow-md hover:scale-105 active:scale-95 focus-visible:outline-2 focus-visible:outline-[#25D366]"
                aria-label={`Enquire about ${service.name} on WhatsApp`}
                title={`Quick WhatsApp Enquiry for ${service.name}`}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
                </svg>
              </a>
            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>

<!-- 3D Card Hover Tilt Interaction Script -->
<script>
  function initServiceCardTilt() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;

    document.querySelectorAll(".service-3d-card").forEach((card) => {
      const el = card as HTMLElement;
      const glare = el.querySelector(".service-card-glare") as HTMLElement | null;

      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -5;
        const rotateY = ((x - centerX) / centerX) * 5;

        el.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-4px)`;

        if (glare) {
          const gx = (x / rect.width) * 100;
          const gy = (y / rect.height) * 100;
          glare.style.background = `radial-gradient(circle at ${gx}% ${gy}%, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0) 65%)`;
        }
      });

      el.addEventListener("mouseleave", () => {
        el.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)";
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServiceCardTilt);
  } else {
    initServiceCardTilt();
  }
</script>
