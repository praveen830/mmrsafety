---
/**
 * Hero.astro — Dual Viewport Architectural Showcase & Quick Access Contact Bar
 *
 * Requirements:
 * - Mobile View (< 768px): Strictly matches FIRST reference video (3D Layered Coverflow Card Carousel)
 * - Desktop View (>= 768px): Strictly matches SECOND reference video (Premium 3D Rotating Image Gallery)
 * - Zero collision: Mobile and Desktop implementations are completely isolated and independent
 * - Integrated Homepage Contact Access Bar pulling verified credentials from siteConfig
 */
import { siteConfig, getWhatsAppUrl, getEmailUrl, getPhoneUrl } from "@data/siteConfig";
import MobileHero3D from "./MobileHero3D.astro";
import DesktopGallery3D from "./DesktopGallery3D.astro";
---

<section
  id="hero-showcase-section"
  class="relative overflow-hidden bg-[var(--color-primary-navy)] border-b border-[var(--color-border-light)]"
  aria-roledescription="showcase"
  aria-label="MMR Safety Featured Services Architectural Showcase"
>
  <!-- Primary Semantic H1 for Search Engine Optimization and Accessibility -->
  <h1 class="sr-only">
    MMR Safety Nets and Invisible Grills in Bangalore — Balcony Safety Nets, Invisible Grills, Pigeon Nets &amp; Cloth Hangers
  </h1>

  <!-- 1. Mobile-Only 3D Layered Coverflow (< 768px) Strictly Matching FIRST Video Reference -->
  <div class="block md:hidden">
    <MobileHero3D />
  </div>

  <!-- 2. Desktop-Only Premium 3D Rotating Gallery (>= 768px) Strictly Matching SECOND Video Reference -->
  <div class="hidden md:block">
    <DesktopGallery3D />
  </div>

  <!-- Deliverable 3: Homepage Main Contact Access Bar (Directly below Showcase) -->
  <div class="relative z-20 border-t border-white/15 bg-gradient-to-r from-[#0d2238] via-[#123B63] to-[#0d2238] py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 md:flex-row">
      
      <!-- Left: Quick Trust Highlights -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-white/90">
        <a href="#ratings" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-0.5 border border-amber-400/30 text-white hover:border-amber-400 hover:text-amber-300 transition-all">
          <span class="text-amber-400 font-black">★ 4.9/5.0</span>
          <span>(1,280+ Reviews)</span>
        </a>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Free On-Site Inspection</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Same-Day Site Visit Available</span>
        </span>
      </div>

      <!-- Right: Three One-Tap Verified Contact Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2.5">
        <!-- 1. Call Now -->
        <a
          href={getPhoneUrl()}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs font-extrabold text-[var(--color-primary-navy)] shadow-md transition-all hover:bg-[var(--color-sky-blue)] hover:shadow-lg active:scale-98"
          aria-label={`Call MMR Safety at ${siteConfig.contact.phone}`}
        >
          <svg class="h-3.5 w-3.5 text-[var(--color-primary-navy)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call: {siteConfig.contact.phone}</span>
        </a>

        <!-- 2. WhatsApp -->
        <a
          href={getWhatsAppUrl("Hello MMR Safety, I would like to get a quote and enquiry for home safety services.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-4 py-2 text-xs font-extrabold text-white shadow-md transition-all hover:bg-[#1ebe5d] hover:shadow-lg active:scale-98"
          aria-label="Chat on WhatsApp with MMR Safety"
        >
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
          </svg>
          <span>WhatsApp Chat</span>
        </a>

        <!-- 3. Email (Strict verified spelling mmrsafetyntes@gmail.com) -->
        <a
          href={getEmailUrl()}
          class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-3.5 py-2 text-xs font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:border-white active:scale-98"
          aria-label={`Email MMR Safety at ${siteConfig.contact.email}`}
        >
          <svg class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>

    </div>
  </div>
</section>
