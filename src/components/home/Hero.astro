---
/**
 * Hero.astro — 7-Slide Automatic Hero Carousel & Quick Access Contact Bar
 *
 * Requirements:
 * - Automatic 7-slide carousel showcasing brand flagship + all 6 services
 * - Image-first visual priority: Large photorealistic photography dominating viewport
 * - Responsive <picture> architecture: Desktop (min-width: 768px) and Mobile images
 * - Interactive controls:
 *   - Auto-advance every 5 seconds (pauses on hover and touch)
 *   - Smooth cinematic transitions with subtle depth
 *   - Previous / Next tactile arrow navigation
 *   - Clickable slide indicator dots and slide counter
 *   - Native mobile touch-swipe support (touchstart / touchend)
 *   - Direct CTA navigation to dedicated /services/[slug]/ pages
 * - Integrated Homepage Contact Access Bar pulling verified credentials from siteConfig
 */
import { heroSlidesData } from "@data/homeData";
import { siteConfig, getWhatsAppUrl, getEmailUrl, getPhoneUrl } from "@data/siteConfig";
---

<section
  id="hero-carousel-section"
  class="relative overflow-hidden bg-[var(--color-primary-navy)] border-b border-[var(--color-border-light)]"
  aria-roledescription="carousel"
  aria-label="MMR Safety Featured Services Carousel"
>
  <!-- Carousel Viewport -->
  <div
    id="hero-carousel"
    class="relative h-[560px] sm:h-[620px] lg:h-[700px] w-full overflow-hidden select-none"
  >
    {
      heroSlidesData.map((slide, index) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${
            index === 0
              ? "opacity-100 z-10 pointer-events-auto"
              : "opacity-0 z-0 pointer-events-none"
          }`}
          data-slide-index={index}
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${index + 1} of ${heroSlidesData.length}: ${slide.title}`}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <!-- Background Responsive <picture> Photographic Visual -->
          <div class="absolute inset-0 h-full w-full overflow-hidden">
            <picture class="h-full w-full">
              <source media="(min-width: 768px)" srcset={slide.imageDesktop} type="image/webp" />
              <img
                src={slide.imageMobile}
                alt={slide.imageAlt}
                width="1920"
                height="1080"
                class="hero-slide-img h-full w-full object-cover transition-transform duration-1000 ease-out"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </picture>

            <!-- Multi-Layer Architectural Contrast Overlays -->
            <!-- 1. Deep navy radial/linear gradient on left to guarantee crystal-clear text readability -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#0d2238]/95 via-[#0d2238]/75 to-transparent sm:via-[#0d2238]/60 lg:w-3/5"></div>
            <!-- 2. Subtle bottom gradient for mobile readability and navigation contrast -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0d2238]/90 via-transparent to-black/20 sm:hidden"></div>
            <!-- 3. Specular ambient glint -->
            <div class="pointer-events-none absolute inset-0 opacity-15 mix-blend-overlay bg-[radial-gradient(#64B5E8_1px,transparent_1px)] [background-size:24px_24px]"></div>
          </div>

          <!-- Slide Content Container -->
          <div class="relative mx-auto flex h-full max-w-7xl items-center px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl text-left pt-6 pb-20 sm:py-16">
              
              <!-- Category / Flagship Badge -->
              <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/95 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] shadow-md backdrop-blur-md">
                <span class="flex h-2 w-2 rounded-full bg-[var(--color-sky-blue)] ring-2 ring-[var(--color-sky-blue)]/40"></span>
                <span>{slide.badge}</span>
              </div>

              <!-- Main Slide Headline -->
              <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight drop-shadow-md">
                {slide.title}
              </h1>

              <!-- Subtitle / Tagline -->
              <p class="mt-3 text-sm sm:text-base lg:text-lg font-medium text-white/90 leading-relaxed drop-shadow-sm max-w-xl">
                {slide.subtitle}
              </p>

              <!-- Spec Badges Grid -->
              <div class="mt-5 flex flex-wrap gap-2">
                {slide.specBadges.map((badge) => (
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-black/35 backdrop-blur-sm px-2.5 py-1 text-xs font-semibold text-white/95">
                    <svg class="h-3.5 w-3.5 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{badge}</span>
                  </span>
                ))}
              </div>

              <!-- Primary & Secondary Action CTAs -->
              <div class="mt-7 flex flex-wrap items-center gap-3.5">
                <a
                  href={slide.primaryCtaLink}
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-sky-blue)] px-6 py-3.5 text-sm font-extrabold text-[var(--color-primary-navy)] shadow-lg transition-all duration-200 hover:bg-white hover:shadow-xl hover:scale-102 focus-visible:outline-2 focus-visible:outline-white active:scale-98"
                >
                  <span>{slide.primaryCtaText}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>

                {slide.secondaryCtaLink.startsWith("http") ? (
                  <a
                    href={slide.secondaryCtaLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md px-5 py-3.5 text-sm font-bold text-white shadow-md transition-all duration-200 hover:bg-white/25 hover:border-white focus-visible:outline-2 focus-visible:outline-white"
                  >
                    <svg class="h-4 w-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
                    </svg>
                    <span>{slide.secondaryCtaText}</span>
                  </a>
                ) : (
                  <a
                    href={slide.secondaryCtaLink}
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 backdrop-blur-md px-5 py-3.5 text-sm font-bold text-white shadow-md transition-all duration-200 hover:bg-white/25 hover:border-white focus-visible:outline-2 focus-visible:outline-white"
                  >
                    <span>{slide.secondaryCtaText}</span>
                  </a>
                )}
              </div>

            </div>
          </div>
        </div>
      ))
    }

    <!-- Carousel Controls: Previous & Next Arrows -->
    <div class="pointer-events-none absolute inset-y-0 inset-x-0 z-20 flex items-center justify-between px-3 sm:px-6">
      <button
        id="hero-prev-btn"
        type="button"
        class="pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full border border-white/25 bg-black/40 text-white backdrop-blur-md transition-all duration-200 hover:bg-[#123B63] hover:border-white hover:scale-108 focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] active:scale-95 shadow-xl"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="hero-next-btn"
        type="button"
        class="pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full border border-white/25 bg-black/40 text-white backdrop-blur-md transition-all duration-200 hover:bg-[#123B63] hover:border-white hover:scale-108 focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] active:scale-95 shadow-xl"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Carousel Bottom Indicator Dots & Slide Counter -->
    <div class="absolute bottom-4 left-0 right-0 z-20 flex items-center justify-center gap-4 px-4">
      
      <!-- Slide Counter Badge -->
      <span
        id="hero-slide-counter"
        class="inline-flex items-center rounded-full border border-white/20 bg-black/40 px-2.5 py-0.5 text-xs font-bold tracking-widest text-white backdrop-blur-md"
      >
        01 / 07
      </span>

      <!-- Clickable Indicator Dots -->
      <div class="flex items-center gap-2" role="tablist" aria-label="Hero carousel slide selector">
        {
          heroSlidesData.map((_, dotIdx) => (
            <button
              type="button"
              class={`hero-dot-btn h-2.5 rounded-full transition-all duration-300 ${
                dotIdx === 0
                  ? "w-8 bg-[var(--color-sky-blue)]"
                  : "w-2.5 bg-white/45 hover:bg-white/80"
              }`}
              data-dot-index={dotIdx}
              role="tab"
              aria-selected={dotIdx === 0 ? "true" : "false"}
              aria-label={`Go to slide ${dotIdx + 1}`}
            />
          ))
        }
      </div>

    </div>
  </div>

  <!-- Deliverable 3: Homepage Main Contact Access Bar (Directly below Slider) -->
  <div class="relative z-20 border-t border-white/15 bg-gradient-to-r from-[#0d2238] via-[#123B63] to-[#0d2238] py-4 px-4 sm:px-6 lg:px-8 shadow-inner">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 md:flex-row">
      
      <!-- Left: Quick Trust Highlights -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-white/90">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Free On-Site Inspection</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Same-Day Site Visit Available</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          <span>Bangalore &amp; Surrounding Areas</span>
        </span>
      </div>

      <!-- Right: Three One-Tap Verified Contact Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2.5">
        <!-- 1. Call Now -->
        <a
          href={getPhoneUrl()}
          class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs font-extrabold text-[var(--color-primary-navy)] shadow-md transition-all hover:bg-[var(--color-sky-blue)] hover:shadow-lg active:scale-98"
          aria-label={`Call MMR Safety at ${siteConfig.contact.phone}`}
        >
          <svg class="h-3.5 w-3.5 text-[var(--color-primary-navy)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call: {siteConfig.contact.phone}</span>
        </a>

        <!-- 2. WhatsApp -->
        <a
          href={getWhatsAppUrl("Hello MMR Safety, I would like to get a quote and enquiry for home safety services.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-4 py-2 text-xs font-extrabold text-white shadow-md transition-all hover:bg-[#1ebe5d] hover:shadow-lg active:scale-98"
          aria-label="Chat on WhatsApp with MMR Safety"
        >
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
          </svg>
          <span>WhatsApp Chat</span>
        </a>

        <!-- 3. Email (Strict verified spelling mmrsafetyntes@gmail.com) -->
        <a
          href={getEmailUrl()}
          class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 px-3.5 py-2 text-xs font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:border-white active:scale-98"
          aria-label={`Email MMR Safety at ${siteConfig.contact.email}`}
        >
          <svg class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>

    </div>
  </div>
</section>

<!-- Carousel Interaction Script (Autoplay, Controls, Touch Swipe, Pauses) -->
<script>
  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel) return;

    const slides = Array.from(carousel.querySelectorAll(".hero-slide")) as HTMLElement[];
    const prevBtn = document.getElementById("hero-prev-btn");
    const nextBtn = document.getElementById("hero-next-btn");
    const dots = Array.from(document.querySelectorAll(".hero-dot-btn")) as HTMLElement[];
    const counter = document.getElementById("hero-slide-counter");

    if (slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayTimer: number | null = null;
    const intervalMs = 5000;

    function formatNumber(num: number): string {
      return num < 10 ? `0${num}` : `${num}`;
    }

    function showSlide(newIndex: number) {
      if (newIndex === currentIndex) return;
      const targetIndex = (newIndex + totalSlides) % totalSlides;

      // Update current slide
      slides[currentIndex].classList.remove("opacity-100", "z-10", "pointer-events-auto");
      slides[currentIndex].classList.add("opacity-0", "z-0", "pointer-events-none");
      slides[currentIndex].setAttribute("aria-hidden", "true");

      // Update next slide
      slides[targetIndex].classList.remove("opacity-0", "z-0", "pointer-events-none");
      slides[targetIndex].classList.add("opacity-100", "z-10", "pointer-events-auto");
      slides[targetIndex].setAttribute("aria-hidden", "false");

      // Update dots
      if (dots[currentIndex]) {
        dots[currentIndex].classList.remove("w-8", "bg-[var(--color-sky-blue)]");
        dots[currentIndex].classList.add("w-2.5", "bg-white/45");
        dots[currentIndex].setAttribute("aria-selected", "false");
      }
      if (dots[targetIndex]) {
        dots[targetIndex].classList.remove("w-2.5", "bg-white/45");
        dots[targetIndex].classList.add("w-8", "bg-[var(--color-sky-blue)]");
        dots[targetIndex].setAttribute("aria-selected", "true");
      }

      // Update counter
      if (counter) {
        counter.textContent = `${formatNumber(targetIndex + 1)} / ${formatNumber(totalSlides)}`;
      }

      currentIndex = targetIndex;
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    // Autoplay Management
    function startAutoplay() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      stopAutoplay();
      autoPlayTimer = window.setInterval(nextSlide, intervalMs);
    }

    function stopAutoplay() {
      if (autoPlayTimer !== null) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    // Button Listeners
    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        nextSlide();
        startAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        prevSlide();
        startAutoplay();
      });
    }

    // Dot Listeners
    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        showSlide(idx);
        startAutoplay();
      });
    });

    // Pause on Hover
    carousel.addEventListener("mouseenter", stopAutoplay);
    carousel.addEventListener("mouseleave", startAutoplay);

    // Pause on Focus Within
    carousel.addEventListener("focusin", stopAutoplay);
    carousel.addEventListener("focusout", startAutoplay);

    // Native Mobile Touch Swipe Support
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    const minSwipeDistance = 45;

    carousel.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        stopAutoplay();
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      },
      { passive: true }
    );

    carousel.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipeGesture();
        startAutoplay();
      },
      { passive: true }
    );

    function handleSwipeGesture() {
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      // Only trigger if horizontal swipe is greater than vertical movement
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > minSwipeDistance) {
        if (diffX < 0) {
          // Swiped Left -> Next Slide
          nextSlide();
        } else {
          // Swiped Right -> Previous Slide
          prevSlide();
        }
      }
    }

    // Keyboard Arrow Navigation
    carousel.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        prevSlide();
        startAutoplay();
      } else if (e.key === "ArrowRight") {
        nextSlide();
        startAutoplay();
      }
    });

    // Start on Initial Load
    startAutoplay();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroCarousel);
  } else {
    initHeroCarousel();
  }
</script>