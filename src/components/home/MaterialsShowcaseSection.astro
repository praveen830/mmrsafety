---
/**
 * MaterialsShowcaseSection.astro — Dedicated Materials & Hardware Engineering Showcase
 *
 * Highlights MMR Safety's 7 core structural materials & components:
 * 1. Marine-Grade Stainless Steel Wires (Invisible Grill Cables)
 * 2. High-Density UV-Stabilized Netting Mesh (Safety & Pigeon Nets)
 * 3. Precision Fixing & Tensioning Accessories (Turnbuckles & Ferrules)
 * 4. Heavy-Duty Hooks, Eye-Bolts & Wall Fasteners
 * 5. Structural Supporting Frames & Aluminium Tracks
 * 6. Ceiling Cloth Hanger Pulleys, Gear Boxes & SS Rods
 * 7. UV-Stabilized Polycarbonate & SS Bird Spike Strips
 */
import { materialsShowcaseData } from "@data/siteConfig";
---

<section
  id="materials-showcase"
  class="bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="materials-showcase-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Hardware Engineering
      </span>
      <h2
        id="materials-showcase-heading"
        class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]"
      >
        Verified Materials &amp; Structural Components
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        Every installation relies on authentic marine-grade alloys, high-density UV polymers, and precision mechanical hardware built for Indian weather endurance.
      </p>
    </div>

    <!-- 7 Materials Showcase Grid -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        materialsShowcaseData.map((mat, index) => (
          <article class="flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
            
            <div>
              <!-- Macro Detail Photographic Visual -->
              <div class="relative aspect-16/10 w-full overflow-hidden bg-[var(--color-soft-bg)]">
                <img
                  src={mat.image}
                  alt={mat.name}
                  width="800"
                  height="500"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-106"
                  loading="lazy"
                  decoding="async"
                />
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
                
                <span class="absolute bottom-3 left-4 text-xs font-bold text-white/95 drop-shadow-md flex items-center gap-1.5">
                  <span class="flex h-1.5 w-1.5 rounded-full bg-[var(--color-sky-blue)]"></span>
                  Material Specification 0{index + 1}
                </span>
              </div>

              <!-- Content Body -->
              <div class="p-6">
                <!-- Badges -->
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {mat.badges.map((b) => (
                    <span class="rounded-md bg-[var(--color-soft-bg)] border border-[var(--color-border-light)] px-2 py-0.5 text-[10px] font-bold text-[var(--color-primary-navy)]">
                      {b}
                    </span>
                  ))}
                </div>

                <h3 class="text-lg font-bold text-[var(--color-primary-navy)]">
                  {mat.name}
                </h3>

                <p class="mt-2 text-xs text-[var(--color-muted-text)] leading-relaxed">
                  {mat.shortDesc}
                </p>

                <!-- Physical Composition -->
                <div class="mt-4 rounded-xl border border-[var(--color-border-light)] bg-[var(--color-soft-bg)]/60 p-3 text-xs">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                    Composition &amp; Metallurgy
                  </div>
                  <div class="mt-0.5 font-semibold text-[var(--color-primary-navy)]">
                    {mat.composition}
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom: Primary Application -->
            <div class="p-6 pt-0 border-t border-[var(--color-border-light)] mt-2">
              <div class="text-xs text-[var(--color-muted-text)]">
                <strong class="font-bold text-[var(--color-primary-navy)] block text-[10px] uppercase tracking-wider mb-0.5">
                  Primary Application:
                </strong>
                <span>{mat.application}</span>
              </div>
            </div>

          </article>
        ))
      }
    </div>

    <!-- Quality Standards Verification Seal Bar -->
    <div class="mt-14 rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-xs flex flex-wrap items-center justify-between gap-4 text-xs text-[var(--color-muted-text)]">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--color-soft-bg)] text-[var(--color-primary-navy)]">
          <svg class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <strong class="text-sm font-bold text-[var(--color-primary-navy)] block">
            Quality Assurance Standard
          </strong>
          <span>Zero recycled plastics &bull; Marine SS 316 cables &bull; Turnkey installation by trained personnel</span>
        </div>
      </div>

      <div class="text-right text-[11px] font-semibold text-[var(--color-primary-navy)]">
        Compliant with Bangalore Apartment Association Guidelines
      </div>
    </div>

  </div>
</section>
