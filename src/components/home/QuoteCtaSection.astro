---
/**
 * QuoteCtaSection.astro — High-Conversion Quote & Inspection Request
 *
 * Dedicated conversion section allowing visitors to request a free site
 * inspection or immediate pricing consultation for their balcony or property.
 */
import { siteConfig } from "@data/siteConfig";
---

<section
  id="quote"
  class="relative bg-gradient-to-b from-[var(--color-soft-bg)] via-white to-[var(--color-soft-bg)] py-20 lg:py-28 scroll-mt-16"
  aria-labelledby="quote-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white shadow-xl">
      <div class="grid lg:grid-cols-12">
        
        <!-- Left: Consultation Value & Reassurance (5 Cols) -->
        <div class="bg-[var(--color-primary-navy)] p-8 sm:p-12 lg:p-14 text-white lg:col-span-5 flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tracking-wider uppercase text-[var(--color-sky-blue)] border border-white/10">
              Get Started
            </span>
            <h2 id="quote-heading" class="heading-section mt-4 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
              Request Your Free On-Site Safety Inspection
            </h2>
            <p class="mt-4 text-sm sm:text-base text-white/80 leading-relaxed">
              Every balcony and window is structurally unique. Let our technician inspect your openings, show physical cable samples, and give you an exact price breakdown with zero obligation.
            </p>

            <!-- 3 Key Promises -->
            <div class="mt-8 space-y-4">
              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sky-blue)]/20 text-[var(--color-sky-blue)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-xs sm:text-sm text-white/90">
                  <strong class="text-white">Free Site Assessment:</strong> Accurate measurements without any survey charge.
                </span>
              </div>

              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sky-blue)]/20 text-[var(--color-sky-blue)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-xs sm:text-sm text-white/90">
                  <strong class="text-white">Physical Samples:</strong> Inspect genuine high-tensile stainless steel cable samples in person.
                </span>
              </div>

              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sky-blue)]/20 text-[var(--color-sky-blue)]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-xs sm:text-sm text-white/90">
                  <strong class="text-white">Transparent Pricing:</strong> No hidden labour, track, or fastener surcharges.
                </span>
              </div>
            </div>
          </div>

          <!-- Direct Immediate Contact Helpdesk -->
          <div class="mt-10 pt-8 border-t border-white/10">
            <p class="text-xs text-white/60 uppercase tracking-wider font-semibold">
              Prefer Immediate Direct Contact?
            </p>
            <div class="mt-3 flex flex-col gap-2">
              <a
                href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, "")}`}
                class="inline-flex items-center gap-2 text-sm sm:text-base font-bold text-white hover:text-[var(--color-sky-blue)] transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{siteConfig.contact.phone}</span>
              </a>
              <a
                href={`mailto:${siteConfig.contact.email}`}
                class="inline-flex items-center gap-2 text-xs text-white/80 hover:text-white transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>{siteConfig.contact.email}</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Right: Inquiry Form (7 Cols) -->
        <div class="p-8 sm:p-12 lg:p-14 lg:col-span-7 bg-white">
          <form
            id="home-quote-form"
            class="space-y-6"
            action="/contact"
            method="get"
          >
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              
              <!-- Full Name -->
              <div>
                <label for="quote-name" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                  Your Full Name <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  id="quote-name"
                  name="name"
                  required
                  placeholder="e.g. Anand Sharma"
                  class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] placeholder:text-[var(--color-muted-text)]/50 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
                />
              </div>

              <!-- Phone Number -->
              <div>
                <label for="quote-phone" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                  Mobile / WhatsApp <span class="text-rose-500">*</span>
                </label>
                <input
                  type="tel"
                  id="quote-phone"
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] placeholder:text-[var(--color-muted-text)]/50 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
                />
              </div>

            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              
              <!-- Required Service -->
              <div>
                <label for="quote-service" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                  Required Service <span class="text-rose-500">*</span>
                </label>
                <select
                  id="quote-service"
                  name="service"
                  required
                  class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
                >
                  <option value="">Select a service...</option>
                  <option value="invisible-grills">Invisible Grills</option>
                  <option value="safety-nets">Balcony Safety Nets</option>
                  <option value="pigeon-safety-nets">Pigeon Safety Nets</option>
                  <option value="sports-nets">Sports &amp; Practice Nets</option>
                  <option value="cloth-hangers">Ceiling Cloth Hangers</option>
                  <option value="bird-spikes">Stainless Steel Bird Spikes</option>
                  <option value="multiple">Multiple / Complete Home Safety</option>
                </select>
              </div>

              <!-- Property Type -->
              <div>
                <label for="quote-property" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                  Property Type
                </label>
                <select
                  id="quote-property"
                  name="property"
                  class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
                >
                  <option value="apartment">High-Rise Apartment Balcony</option>
                  <option value="villa">Independent Villa / House</option>
                  <option value="window">Window / Utility Shaft</option>
                  <option value="commercial">Commercial / Sports Clubhouse</option>
                </select>
              </div>

            </div>

            <!-- Locality / City -->
            <div>
              <label for="quote-locality" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                Locality / Apartment Name / Pin Code <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="quote-locality"
                name="locality"
                required
                placeholder="e.g. Prestige Lakeside Habitat, Whitefield, Bengaluru"
                class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] placeholder:text-[var(--color-muted-text)]/50 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
              />
            </div>

            <!-- Additional Details / Dimensions -->
            <div>
              <label for="quote-message" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-2">
                Approximate Dimensions or Notes (Optional)
              </label>
              <textarea
                id="quote-message"
                name="message"
                rows="3"
                placeholder="e.g. 2 balconies (approx 12ft x 5ft each), looking for invisible grills on 14th floor."
                class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-3 text-sm text-[var(--color-main-text)] placeholder:text-[var(--color-muted-text)]/50 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all resize-none"
              ></textarea>
            </div>

            <!-- Submit Button & Privacy Note -->
            <div>
              <button
                type="submit"
                class="w-full flex items-center justify-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-8 py-4 text-sm font-bold text-white shadow-md transition-all hover:bg-[var(--color-primary-navy-light)] hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sky-blue)] active:scale-[0.99]"
              >
                <span>Request Free Site Measurement &amp; Quote</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
              
              <p class="mt-3 text-center text-[11px] text-[var(--color-muted-text)]">
                🔒 We respect your privacy. Your information is used strictly to arrange your site survey and provide your quotation.
              </p>
            </div>

          </form>
        </div>

      </div>
    </div>

  </div>
</section>
