---
/**
 * ComparisonSection.astro — Interactive Before vs After Installation Comparison
 *
 * Image-centric minimalist design:
 * - Clean small titles with zero heavy paragraph text
 * - Highlighted, tall image slider on mobile (aspect 4:5 on mobile, 16:9 on desktop)
 * - Before: High-res authentic image of open balcony with pigeons & droppings
 * - After 1: MMR SS-316 Invisible Grills with clean luxury balcony
 * - After 2: MMR Heavy-Duty Safety Nets on clean balcony
 * - Touch-enabled interactive split comparison slider
 */
---

<section
  id="comparison"
  class="relative bg-white py-8 sm:py-14 lg:py-18 border-b border-[var(--color-border-light)] scroll-mt-16 overflow-hidden"
  aria-labelledby="comparison-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Image Style with Small Titles — Zero Heavy Paragraphs) -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-sky-300 bg-sky-50 px-3 py-0.5 sm:px-3.5 sm:py-1 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] shadow-2xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        MMR Safety Nets &amp; Invisible Grills
      </span>

      <h2 id="comparison-heading" class="heading-section mt-2 text-xl sm:text-2xl lg:text-3xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        Before vs After <span class="text-[var(--color-sky-blue-dark)]">Installation</span>
      </h2>

      <!-- Solution Selector Tabs -->
      <div class="mt-3 sm:mt-4 flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          id="tab-btn-grills"
          class="solution-tab-btn active inline-flex items-center gap-1.5 sm:gap-2 rounded-full px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-bold border transition-all cursor-pointer bg-[var(--color-primary-navy)] text-white border-[var(--color-primary-navy)] shadow-xs"
          data-solution="grills"
          aria-pressed="true"
        >
          <span>🕊️</span>
          <span>Pigeon Problem ➔ Invisible Grills</span>
        </button>

        <button
          type="button"
          id="tab-btn-nets"
          class="solution-tab-btn inline-flex items-center gap-1.5 sm:gap-2 rounded-full px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-bold border transition-all cursor-pointer bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100"
          data-solution="nets"
          aria-pressed="false"
        >
          <span>🛡️</span>
          <span>Pigeon Problem ➔ Safety Nets</span>
        </button>
      </div>

      <p class="mt-2 text-[11px] sm:text-xs font-semibold text-emerald-700">
        Drag the slider handle ⇄ left or right to see transformation
      </p>
    </div>

    <!-- Interactive Comparison Slider Container (Taller on Mobile for Maximum Visual Highlight) -->
    <div class="relative mx-auto mt-4 sm:mt-6 max-w-4xl select-none">
      <div
        id="comparison-container"
        class="relative aspect-[4/5] sm:aspect-[16/10] lg:aspect-[16/9] w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-2xl bg-neutral-900 cursor-ew-resize touch-pan-y ring-1 ring-slate-100"
        style="--slider-pos: 50%;"
      >
        <!-- Base: After Installation Solution (Underneath) -->
        <img
          id="comparison-after-img"
          src="/images/comparison/after-invisible-grills.jpg"
          alt="After MMR Invisible Grills Installation: Clean, Safe Luxury Balcony"
          width="1200"
          height="675"
          class="absolute inset-0 h-full w-full object-cover select-none pointer-events-none transition-opacity duration-300"
          loading="eager"
          decoding="async"
          draggable="false"
        />

        <!-- Badge for After (Right side) -->
        <span
          id="comparison-after-badge"
          class="absolute top-2.5 right-2.5 sm:top-4 sm:right-4 z-10 flex items-center gap-1.5 bg-white/95 backdrop-blur-md border border-emerald-300 text-emerald-800 text-[10px] sm:text-xs md:text-sm px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full font-bold shadow-md pointer-events-none select-none"
        >
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-500"></span>
          <span id="badge-after-text">AFTER: MMR Invisible Grills</span>
        </span>

        <!-- Overlay: Before Installation Problem (Clipped by slider position) -->
        <div
          id="comparison-overlay"
          class="absolute inset-0 h-full w-full overflow-hidden pointer-events-none select-none z-10"
          style="clip-path: inset(0 calc(100% - var(--slider-pos, 50%)) 0 0);"
        >
          <img
            id="comparison-before-img"
            src="/images/comparison/before-pigeon-problem.jpg"
            alt="Before Installation: Multiple Pigeons Menace and Mess on Balcony"
            width="1200"
            height="675"
            class="absolute inset-0 h-full w-full object-cover select-none pointer-events-none"
            loading="eager"
            decoding="async"
            draggable="false"
          />

          <!-- Badge for Before (Left side) -->
          <span
            id="comparison-before-badge"
            class="absolute top-2.5 left-2.5 sm:top-4 sm:left-4 z-10 flex items-center gap-1.5 bg-white/95 backdrop-blur-md border border-rose-300 text-rose-800 text-[10px] sm:text-xs md:text-sm px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full font-bold shadow-md pointer-events-none select-none whitespace-nowrap"
          >
            <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
            <span id="badge-before-text">BEFORE: Multiple Pigeons Menace</span>
          </span>
        </div>

        <!-- Draggable Divider Line & Handle -->
        <div
          id="comparison-slider-handle"
          class="absolute top-0 bottom-0 z-20 w-0.5 bg-white shadow-xl pointer-events-none will-change-[left]"
          style="left: var(--slider-pos, 50%); transform: translateX(-50%);"
        >
          <div
            role="slider"
            tabindex="0"
            aria-valuenow="50"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="Balcony before and after installation comparison slider"
            class="pointer-events-auto absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex h-9 w-9 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white text-[var(--color-primary-navy)] font-black text-xs sm:text-sm border-2 border-[var(--color-sky-blue-dark)] shadow-2xl transition-transform hover:scale-110 active:scale-95 cursor-ew-resize focus:outline-none focus:ring-4 focus:ring-sky-400/60"
          >
            ⇄
          </div>
        </div>

        <!-- Hidden Range Input for Accessibility -->
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          id="comparison-range"
          class="sr-only"
          aria-label="Comparison slider between pigeon menace before installation and MMR solution after installation"
        />
      </div>

      <!-- Sleek Compact Status Pills with Small Titles (Zero Heavy Paragraphs) -->
      <div class="flex flex-wrap items-center justify-between gap-2 mt-3.5 px-0.5">
        <div class="inline-flex items-center gap-2 rounded-full bg-rose-50/95 border border-rose-200/90 px-3.5 py-1 text-xs font-bold text-rose-700 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0 animate-pulse"></span>
          <span id="card-before-title">Before: Multiple Pigeons Menace</span>
        </div>

        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50/95 border border-emerald-200/90 px-3.5 py-1 text-xs font-bold text-emerald-800 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
          <span id="card-after-title">After: MMR Invisible Grills</span>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  interface SolutionData {
    afterImg: string;
    afterBadge: string;
    afterCardTitle: string;
  }

  const solutions: Record<string, SolutionData> = {
    grills: {
      afterImg: "/images/comparison/after-invisible-grills.jpg",
      afterBadge: "AFTER: MMR Invisible Grills",
      afterCardTitle: "After: MMR Invisible Grills",
    },
    nets: {
      afterImg: "/images/comparison/after-safety-nets.jpg",
      afterBadge: "AFTER: MMR Pigeon Safety Nets",
      afterCardTitle: "After: MMR Safety Nets",
    }
  };

  function initComparisonSection() {
    const container = document.getElementById("comparison-container");
    const overlay = document.getElementById("comparison-overlay");
    const handle = document.getElementById("comparison-slider-handle");
    const range = document.getElementById("comparison-range") as HTMLInputElement | null;

    const afterImg = document.getElementById("comparison-after-img") as HTMLImageElement | null;
    const badgeAfter = document.getElementById("badge-after-text");
    const cardAfterTitle = document.getElementById("card-after-title");

    const tabBtns = document.querySelectorAll(".solution-tab-btn");

    if (!container || !overlay || !handle) return;

    let isDown = false;

    function setPosition(xPos: number) {
      const rect = container!.getBoundingClientRect();
      let pos = (xPos - rect.left) / rect.width;
      if (pos < 0) pos = 0;
      if (pos > 1) pos = 1;

      const pct = (pos * 100).toFixed(1);
      container!.style.setProperty("--slider-pos", `${pct}%`);
      overlay!.style.clipPath = `inset(0 calc(100% - ${pct}%) 0 0)`;
      handle!.style.left = `${pct}%`;

      if (range) {
        range.value = pct;
        range.setAttribute("aria-valuenow", pct);
      }
    }

    container.addEventListener("mousedown", (e) => {
      isDown = true;
      setPosition(e.clientX);
    });

    window.addEventListener("mouseup", () => {
      isDown = false;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      setPosition(e.clientX);
    });

    // Touch support for mobile devices
    container.addEventListener("touchstart", (e) => {
      isDown = true;
      if (e.touches[0]) setPosition(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener("touchend", () => {
      isDown = false;
    });

    window.addEventListener("touchmove", (e) => {
      if (!isDown) return;
      if (e.touches[0]) setPosition(e.touches[0].clientX);
    }, { passive: true });

    // Keyboard accessibility
    if (range) {
      range.addEventListener("input", () => {
        const val = range.value;
        container.style.setProperty("--slider-pos", `${val}%`);
        overlay.style.clipPath = `inset(0 calc(100% - ${val}%) 0 0)`;
        handle.style.left = `${val}%`;
      });
    }

    const handleThumb = handle.querySelector('[role="slider"]');
    if (handleThumb) {
      handleThumb.addEventListener("keydown", (e: any) => {
        const cur = parseFloat(range?.value || "50");
        if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
          e.preventDefault();
          const next = Math.max(0, cur - 5);
          container.style.setProperty("--slider-pos", `${next}%`);
          overlay.style.clipPath = `inset(0 calc(100% - ${next}%) 0 0)`;
          handle.style.left = `${next}%`;
          if (range) range.value = next.toString();
        } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
          e.preventDefault();
          const next = Math.min(100, cur + 5);
          container.style.setProperty("--slider-pos", `${next}%`);
          overlay.style.clipPath = `inset(0 calc(100% - ${next}%) 0 0)`;
          handle.style.left = `${next}%`;
          if (range) range.value = next.toString();
        }
      });
    }

    // Tab switching for solutions (Invisible Grills vs Safety Nets)
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-solution") || "grills";
        const data = solutions[key];
        if (!data) return;

        tabBtns.forEach((b) => {
          b.classList.remove("bg-[var(--color-primary-navy)]", "text-white", "border-[var(--color-primary-navy)]", "shadow-md");
          b.classList.add("bg-slate-50", "text-slate-700", "border-slate-200");
          b.setAttribute("aria-pressed", "false");
        });

        btn.classList.add("bg-[var(--color-primary-navy)]", "text-white", "border-[var(--color-primary-navy)]", "shadow-md");
        btn.classList.remove("bg-slate-50", "text-slate-700", "border-slate-200");
        btn.setAttribute("aria-pressed", "true");

        if (afterImg) afterImg.src = data.afterImg;
        if (badgeAfter) badgeAfter.textContent = data.afterBadge;
        if (cardAfterTitle) cardAfterTitle.textContent = data.afterCardTitle;
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initComparisonSection);
  } else {
    initComparisonSection();
  }

  document.addEventListener("astro:page-load", initComparisonSection);
</script>
