---
/**
 * WhyChooseUs.astro — Why Choose MMR Safety
 *
 * Explains the foundational engineering and service pillars of MMR Safety Nets
 * and Invisible Grills without unverified statistics or fake certifications.
 */
import { whyChooseData } from "@data/homeData";
---

<section
  id="why-us"
  class="relative bg-white py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="why-us-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        The MMR Advantage
      </span>
      <h2 id="why-us-heading" class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        Why Homeowners &amp; Architects Choose MMR
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        Balcony safety is a long-term structural investment. Here is how our materials, workmanship, and architectural approach set us apart.
      </p>
    </div>

    <!-- 6 Pillars Grid -->
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        whyChooseData.map((item) => (
          <div class="relative flex flex-col rounded-2xl border border-[var(--color-border-light)] bg-[var(--color-soft-bg)] p-8 shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:bg-white hover:shadow-lg">
            
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[var(--color-metallic-silver)]">
                {item.number}
              </span>
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white border border-[var(--color-border-light)] text-[var(--color-primary-navy)] shadow-xs">
                {item.number === "01" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {item.number === "02" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.number === "03" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
                {item.number === "04" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
                {item.number === "05" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
                {item.number === "06" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                )}
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold text-[var(--color-primary-navy)]">
              {item.title}
            </h3>
            <p class="mt-2 text-sm text-[var(--color-muted-text)] leading-relaxed">
              {item.description}
            </p>

          </div>
        ))
      }
    </div>

  </div>
</section>
