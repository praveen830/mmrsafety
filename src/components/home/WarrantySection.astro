---
/**
 * WarrantySection.astro — Dedicated Transparent Warranty Structure
 *
 * Horizontal Auto-Sliding Carousel:
 * - Slides horizontally with a 1-second pause on each card.
 * - Prominent warranty badge & shield highlights so visitors immediately understand warranty terms.
 * - Minimal text focused on verified guarantees, high-resolution product photography, and easy claims.
 * - Seamless infinite loop, pause-on-hover/touch, and responsive cards.
 */
import { warrantyTermsData, getPhoneUrl, getEmailUrl, siteConfig } from "@data/siteConfig";

const phoneUrl = getPhoneUrl();
const emailUrl = getEmailUrl(undefined, "Warranty Inspection Request - MMR Safety");

// Product photographic visuals
const warrantyImages: Record<string, string> = {
  "invisible-grills": "/images/desktop/invisible-grills.webp",
  "safety-nets": "/images/desktop/safety-nets.webp",
  "pigeon-safety-nets": "/images/desktop/pigeon-safety-nets.webp",
  "sports-nets": "/images/desktop/sports-nets.webp",
  "cloth-hangers": "/images/desktop/cloth-hangers.webp",
  "bird-spikes": "/images/desktop/bird-spikes.webp",
};

interface WarrantyHighlight {
  years: string;
  badgeClass: string;
  headline: string;
  scope: string;
  perks: string[];
}

// Highlighted warranty metadata inspired by official warranty & guarantee standards
const warrantyHighlights: Record<string, WarrantyHighlight> = {
  "invisible-grills": {
    years: "5 YEARS WARRANTY",
    badgeClass: "bg-emerald-600 text-white border-emerald-400 shadow-emerald-900/30",
    headline: "5-Year Structural Cable & Rust Warranty",
    scope: "100% free replacement on cable corrosion + complimentary on-site re-tensioning.",
    perks: ["316 Marine Alloy", "Free Re-Tensioning"],
  },
  "safety-nets": {
    years: "3-5 YEARS WARRANTY",
    badgeClass: "bg-emerald-600 text-white border-emerald-400 shadow-emerald-900/30",
    headline: "3 to 5-Year UV & Net Endurance Warranty",
    scope: "Guaranteed resistance against UV sun rot, net unraveling, and anchor hook detachment.",
    perks: ["UV-Stabilized HDPE", "Solid Concrete Anchors"],
  },
  "pigeon-safety-nets": {
    years: "3 YEARS WARRANTY",
    badgeClass: "bg-sky-600 text-white border-sky-400 shadow-sky-900/30",
    headline: "3-Year Weather & Bird Barrier Warranty",
    scope: "Guaranteed translucent monofilament endurance against intense sunlight, rain, and bird breach.",
    perks: ["Translucent Mesh", "Free Gap Re-Sealing"],
  },
  "sports-nets": {
    years: "2-3 YEARS WARRANTY",
    badgeClass: "bg-amber-600 text-white border-amber-400 shadow-amber-900/30",
    headline: "2 to 3-Year High-Impact Cord Warranty",
    scope: "High-impact braided synthetic cord shock absorption & reinforced border rope hemming.",
    perks: ["High-Impact Absorption", "Guide Wire Tightening"],
  },
  "cloth-hangers": {
    years: "2 YEARS WARRANTY",
    badgeClass: "bg-sky-600 text-white border-sky-400 shadow-sky-900/30",
    headline: "2-Year Rustproof & Mechanical Warranty",
    scope: "Full rust resistance on stainless steel drying pipes & smooth dual-pulley mechanics.",
    perks: ["Rustproof Stainless Steel", "Free Pulley Servicing"],
  },
  "bird-spikes": {
    years: "3-5 YEARS WARRANTY",
    badgeClass: "bg-emerald-600 text-white border-emerald-400 shadow-emerald-900/30",
    headline: "3 to 5-Year Polycarbonate & Pin Warranty",
    scope: "Guaranteed stainless steel wire pin retention & flexible UV-stabilized base against cracking.",
    perks: ["Rust-Proof SS Pins", "UV-Resistant Polycarb"],
  },
};

// Duplicate items for infinite seamless looping
const extendedWarrantyData = [...warrantyTermsData, ...warrantyTermsData];
---

<section
  id="warranty"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16 overflow-hidden"
  aria-labelledby="warranty-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Slider Navigation Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
          Official Warranty &bull; Reliability &amp; Integrity
        </span>
        <h2
          id="warranty-heading"
          class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]"
        >
          Honest Warranty Coverage &amp; Service Terms
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[var(--color-muted-text)] leading-relaxed">
          Transparent warranty coverage across all installations with complimentary on-site technical inspection.
        </p>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          id="warranty-prev-btn"
          type="button"
          aria-label="Previous Warranty Card"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-md active:scale-95"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="warranty-next-btn"
          type="button"
          aria-label="Next Warranty Card"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-md active:scale-95"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Horizontal Auto-Sliding Viewport -->
    <div
      class="relative mt-12 select-none overflow-hidden rounded-3xl"
      id="warranty-slider-viewport"
      aria-roledescription="carousel"
      aria-label="Warranty Coverage Cards"
    >
      <div
        id="warranty-slider-track"
        class="flex gap-6 will-change-transform"
        style="transform: translateX(0px);"
      >
        {
          extendedWarrantyData.map((w) => {
            const img = warrantyImages[w.id] || "/images/desktop/invisible-grills.webp";
            const info = warrantyHighlights[w.id] || {
              years: w.periodBadge,
              badgeClass: "bg-emerald-600 text-white border-emerald-400",
              headline: `${w.serviceName} Guarantee`,
              scope: "Guaranteed structural durability & full on-site servicing.",
              perks: ["Material Guarantee", "Free Inspection"],
            };
            const whatsappMsg = `Hello MMR Safety, I would like to verify the ${info.years} coverage and terms for ${w.serviceName}.`;
            const whatsappUrl = `https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(whatsappMsg)}`;

            return (
              <article
                class="warranty-card group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-xl shrink-0 w-[280px] sm:w-[320px] lg:w-[340px]"
              >
                <div>
                  <!-- Photographic Visual with Prominent Warranty Shield Overlay -->
                  <div class="relative aspect-4/3 w-full overflow-hidden bg-[var(--color-soft-bg)]">
                    <img
                      src={img}
                      alt={`${w.serviceName} — ${info.years}`}
                      width="600"
                      height="450"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                    
                    <!-- HIGH-IMPACT PROMINENT WARRANTY SHIELD BADGE -->
                    <div class={`absolute top-3.5 right-3.5 z-10 flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[11px] font-black uppercase tracking-wider shadow-lg border backdrop-blur-md ${info.badgeClass}`}>
                      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM13.707 8.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span>{info.years}</span>
                    </div>

                    <!-- Official Warranty Stamp Bottom-Left -->
                    <span class="absolute bottom-3 left-3 text-xs font-bold text-white drop-shadow-md flex items-center gap-1.5 bg-black/65 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/20">
                      <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      Official MMR Warranty
                    </span>
                  </div>

                  <!-- Highlighted Warranty Text Content -->
                  <div class="p-4 sm:p-5">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors line-clamp-1">
                      {w.serviceName}
                    </h3>
                    
                    <!-- Highlighted Warranty Strip Banner -->
                    <div class="mt-2.5 flex items-center gap-2 rounded-xl bg-emerald-50 border border-emerald-200/80 px-3 py-1.5 text-xs font-bold text-emerald-900">
                      <svg class="h-3.5 w-3.5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM13.707 8.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span class="line-clamp-1">{info.headline}</span>
                    </div>

                    <p class="mt-2 text-xs text-[var(--color-muted-text)] leading-relaxed line-clamp-2">
                      {info.scope}
                    </p>

                    <!-- Key Warranty Perks Badges -->
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {info.perks.map((perk) => (
                        <span class="inline-flex items-center gap-1 rounded-md bg-[var(--color-soft-bg)] border border-[var(--color-border-light)] px-2 py-0.5 text-[10px] font-semibold text-[var(--color-primary-navy)]">
                          <svg class="h-2.5 w-2.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          <span>{perk}</span>
                        </span>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- High-Conversion Warranty Claim Button -->
                <div class="p-4 sm:p-5 pt-0">
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex w-full items-center justify-between rounded-xl bg-[var(--color-primary-navy)] px-4 py-2.5 text-xs font-bold text-white shadow-xs transition-all hover:bg-[var(--color-sky-blue-dark)] hover:shadow-md active:scale-98"
                  >
                    <span class="flex items-center gap-1.5">
                      <svg class="h-3.5 w-3.5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM13.707 8.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span>Verify &amp; Claim Warranty</span>
                    </span>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <!-- Navigation Dots Indicator -->
    <div class="mt-8 flex items-center justify-center gap-2" id="warranty-slider-dots">
      {
        warrantyTermsData.map((_, i) => (
          <button
            type="button"
            class="warranty-dot h-2 rounded-full transition-all duration-300"
            data-index={i}
            aria-label={`Go to warranty slide ${i + 1}`}
          />
        ))
      }
    </div>

    <!-- Bottom Contact Notice Bar -->
    <div class="mt-12 rounded-3xl border border-[var(--color-border)] bg-white p-6 sm:p-8 shadow-xs flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)]">
          Need a Warranty Check or Maintenance Re-Tensioning?
        </h3>
        <p class="text-xs sm:text-sm text-[var(--color-muted-text)]">
          Our in-house technical team is on call across all localities in Bengaluru. Call or email with your address for fast scheduling.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href={phoneUrl}
          class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-5 py-2.5 text-xs font-bold text-white shadow-xs transition-all hover:bg-[var(--color-primary-navy)]/90 active:scale-98"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call: {siteConfig.contact.phone}</span>
        </a>

        <a
          href={emailUrl}
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-5 py-2.5 text-xs font-bold text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-white active:scale-98"
        >
          <svg class="h-4 w-4 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email: {siteConfig.contact.email}</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  function initWarrantyCarousel() {
    const viewport = document.getElementById("warranty-slider-viewport");
    const track = document.getElementById("warranty-slider-track");
    const prevBtn = document.getElementById("warranty-prev-btn");
    const nextBtn = document.getElementById("warranty-next-btn");
    const dots = document.querySelectorAll(".warranty-dot");

    if (!viewport || !track) return;

    const cards = track.querySelectorAll(".warranty-card");
    const totalOriginalCards = 6;
    if (cards.length === 0) return;

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let isPaused = false;
    let isTransitioning = false;

    function getCardStep(): number {
      if (cards.length > 1) {
        const first = cards[0] as HTMLElement;
        const second = cards[1] as HTMLElement;
        return second.offsetLeft - first.offsetLeft;
      }
      return (cards[0] as HTMLElement).offsetWidth + 24;
    }

    function updateDots() {
      const activeIndex = currentIndex % totalOriginalCards;
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.className = "warranty-dot h-2 w-7 rounded-full bg-[var(--color-primary-navy)] transition-all duration-300";
        } else {
          dot.className = "warranty-dot h-2 w-2 rounded-full bg-[var(--color-border)] hover:bg-[var(--color-muted-text)] transition-all duration-300";
        }
      });
    }

    function goToIndex(index: number, animate = true) {
      currentIndex = index;
      const step = getCardStep();
      if (animate) {
        track!.style.transition = "transform 500ms cubic-bezier(0.25, 1, 0.5, 1)";
      } else {
        track!.style.transition = "none";
      }
      track!.style.transform = `translateX(-${currentIndex * step}px)`;
      updateDots();
    }

    function nextSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      goToIndex(currentIndex, true);

      setTimeout(() => {
        if (currentIndex >= totalOriginalCards) {
          currentIndex = 0;
          goToIndex(0, false);
        }
        isTransitioning = false;
      }, 520);
    }

    function prevSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      if (currentIndex <= 0) {
        currentIndex = totalOriginalCards;
        goToIndex(totalOriginalCards, false);
        void track!.offsetHeight;
      }
      currentIndex--;
      goToIndex(currentIndex, true);

      setTimeout(() => {
        isTransitioning = false;
      }, 520);
    }

    function startAutoplay() {
      stopAutoplay();
      // 1-second pause on each slide + 500ms transition = 1500ms cycle
      timer = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, 1500);
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    viewport.addEventListener("mouseenter", () => {
      isPaused = true;
    });
    viewport.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        nextSlide();
        startAutoplay();
      });
    }
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        prevSlide();
        startAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
        goToIndex(idx, true);
        startAutoplay();
      });
    });

    let touchStartX = 0;
    let touchEndX = 0;

    viewport.addEventListener(
      "touchstart",
      (e) => {
        isPaused = true;
        touchStartX = (e as TouchEvent).touches[0].clientX;
      },
      { passive: true }
    );

    viewport.addEventListener(
      "touchend",
      (e) => {
        touchEndX = (e as TouchEvent).changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
        isPaused = false;
        startAutoplay();
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      goToIndex(currentIndex, false);
    });

    goToIndex(0, false);
    startAutoplay();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWarrantyCarousel);
  } else {
    initWarrantyCarousel();
  }
</script>
