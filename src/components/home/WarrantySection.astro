---
/**
 * WarrantySection.astro — Dedicated Transparent Warranty Structure
 *
 * Explains honest, configurable warranty terms across all six product lines:
 * Invisible Grills, Safety Nets, Pigeon Nets, Sports Nets, Cloth Hangers, and Bird Spikes.
 * Highlights: Covered vs Not Covered, Maintenance Care, and Direct Claim Procedure.
 */
import { warrantyTermsData, getPhoneUrl, getEmailUrl, siteConfig } from "@data/siteConfig";

const phoneUrl = getPhoneUrl();
const emailUrl = getEmailUrl(undefined, "Warranty Inspection Request - MMR Safety");
---

<section
  id="warranty"
  class="bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="warranty-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Reliability &amp; Integrity
      </span>
      <h2
        id="warranty-heading"
        class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]"
      >
        Honest Warranty Coverage &amp; Service Terms
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        We stand behind our materials and craftsmanship. Transparent terms without hidden asterisks, false ISO badges, or unverified claims.
      </p>
    </div>

    <!-- Warranty Cards Grid (6 Products) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        warrantyTermsData.map((w, index) => (
          <article class="flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-7 shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
            
            <div>
              <!-- Header: Service Title & Configurable Period Badge -->
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                    Product Line 0{index + 1}
                  </span>
                  <h3 class="text-xl font-bold text-[var(--color-primary-navy)] mt-1">
                    {w.serviceName}
                  </h3>
                </div>
                <span class="inline-flex items-center rounded-full bg-[var(--color-soft-bg)] border border-[var(--color-border)] px-3 py-1 text-xs font-bold text-[var(--color-primary-navy)] shrink-0">
                  {w.periodBadge}
                </span>
              </div>

              <!-- Scope Headline -->
              <div class="mt-4 rounded-xl bg-[var(--color-soft-bg)]/70 border border-[var(--color-border-light)] p-3 text-xs text-[var(--color-primary-navy)] font-semibold">
                {w.warrantyPeriod}
              </div>

              <!-- What Is Covered -->
              <div class="mt-6">
                <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 flex items-center gap-1.5">
                  <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>What Is Covered</span>
                </h4>
                <ul class="mt-2.5 space-y-1.5 text-xs text-[var(--color-muted-text)] leading-relaxed">
                  {w.covered.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-500 font-bold shrink-0">&bull;</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- What Is Not Covered -->
              <div class="mt-5 pt-4 border-t border-[var(--color-border-light)]">
                <h4 class="text-xs font-bold uppercase tracking-wider text-amber-700 flex items-center gap-1.5">
                  <svg class="h-4 w-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>What Is Not Covered</span>
                </h4>
                <ul class="mt-2 space-y-1 text-xs text-[var(--color-muted-text)] leading-relaxed">
                  {w.notCovered.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-500 font-bold shrink-0">&bull;</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Care & Maintenance -->
              <div class="mt-5 pt-4 border-t border-[var(--color-border-light)] text-xs text-[var(--color-muted-text)] leading-relaxed">
                <strong class="font-bold text-[var(--color-primary-navy)] block mb-1">Recommended Care:</strong>
                {w.careConditions}
              </div>
            </div>

            <!-- Claim Instruction Footer -->
            <div class="mt-6 pt-4 border-t border-[var(--color-border-light)]">
              <div class="rounded-xl bg-[var(--color-soft-bg)] p-3 text-[11px] text-[var(--color-primary-navy)]/90 leading-relaxed">
                <strong class="font-bold text-[var(--color-primary-navy)] block mb-0.5">How to Claim Inspection:</strong>
                {w.claimProcess}
              </div>
            </div>

          </article>
        ))
      }
    </div>

    <!-- Bottom Contact Notice Bar -->
    <div class="mt-14 rounded-3xl border border-[var(--color-border)] bg-white p-8 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="text-lg font-bold text-[var(--color-primary-navy)]">
          Need a Warranty Check or Maintenance Re-Tensioning?
        </h3>
        <p class="text-sm text-[var(--color-muted-text)]">
          Our in-house technical team is on call across all localities in Bengaluru. Call or email with your address for fast scheduling.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href={phoneUrl}
          class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-5 py-3 text-xs font-bold text-white shadow-xs transition-all hover:bg-[var(--color-primary-navy)]/90 active:scale-98"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call: {siteConfig.contact.phone}</span>
        </a>

        <a
          href={emailUrl}
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-5 py-3 text-xs font-bold text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-white active:scale-98"
        >
          <svg class="h-4 w-4 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email: {siteConfig.contact.email}</span>
        </a>
      </div>
    </div>

  </div>
</section>
