---
/**
 * ServiceAreasSection.astro — Confirmed Operational Service Zones
 *
 * Horizontal Auto-Sliding Carousel:
 * - Slides horizontally with a 1-second pause on each location card.
 * - Image-led representation of what MMR Safety provides in each area.
 * - Minimal text focused on location, service representation, and quick WhatsApp dispatch.
 * - Seamless infinite loop, pause on hover/touch, and responsive cards.
 */
import {
  serviceAreasData,
  siteConfig,
  getPhoneUrl,
  getWhatsAppUrl,
  getAreaSiteVisitMessage,
} from "@data/siteConfig";

interface Props {
  title?: string;
  subtitle?: string;
  showContactPrompt?: boolean;
}

const {
  title = "Confirmed Service Zones & On-Site Availability Across Bengaluru",
  subtitle = "Our mobile technical vans carry physical samples and laser measurement gear directly to your doorstep. Explore our confirmed operational areas below.",
  showContactPrompt = true,
} = Astro.props;

const phoneUrl = getPhoneUrl();

// Visual representation of what MMR Safety provides in each specific area
const areaImageCards: Record<string, { image: string; whatWeProvide: string }> = {
  "whitefield-marathahalli": {
    image: "/images/services/benefits/invisible-grills/ig-skyline-view.jpg",
    whatWeProvide: "High-Rise Balcony Invisible Grills & Safety Nets",
  },
  "electronic-city-sarjapur": {
    image: "/images/services/benefits/safety-nets/sn-child-pet-security.jpg",
    whatWeProvide: "Balcony Child Safety Nets & Ceiling Cloth Hangers",
  },
  "bellandur-outer-ring-road": {
    image: "/images/services/benefits/pigeon-safety-nets/pn-balcony-cleanliness.jpg",
    whatWeProvide: "Discreet Pigeon Safety Nets & Anti-Perch Spikes",
  },
  "hsr-layout-koramangala": {
    image: "/images/services/benefits/cloth-hangers/ch-ceiling-integration.jpg",
    whatWeProvide: "Ceiling Pulley Cloth Hangers & Balcony Nets",
  },
  "hebbal-thanisandra": {
    image: "/images/services/benefits/sports-nets/sp-cricket-turf.jpg",
    whatWeProvide: "Rooftop Turf Sports Nets & Fall Protection",
  },
  "jp-nagar-kanakapura": {
    image: "/images/services/benefits/safety-nets/sn-discreet-footprint.jpg",
    whatWeProvide: "Balcony Invisible Grills & Stairwell Safety Nets",
  },
  "indiranagar-central": {
    image: "/images/services/benefits/bird-spikes/bs-architectural-invisible.jpg",
    whatWeProvide: "Architectural Invisible Grills & Humane Bird Spikes",
  },
  "yeshwanthpur-malleshwaram": {
    image: "/images/projects/project-invisible-grills.jpg",
    whatWeProvide: "Gated Community Balcony Safety Nets & Grills",
  },
};

// Duplicate items for infinite seamless looping
const extendedAreasData = [...serviceAreasData, ...serviceAreasData];
---

<section
  id="service-areas"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16 overflow-hidden"
  aria-labelledby="areas-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Slider Navigation Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
          Operational Coverage
        </span>
        <h2 id="areas-heading" class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
          {title}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[var(--color-muted-text)] leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          id="areas-prev-btn"
          type="button"
          aria-label="Previous Area"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-md active:scale-95"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="areas-next-btn"
          type="button"
          aria-label="Next Area"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary-navy)] shadow-xs transition-all hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-md active:scale-95"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Rapid Dispatch Indicators -->
    <div class="mt-10 mx-auto max-w-4xl grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Same-Day / 24h Visits</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Prompt technician scheduling for all sectors.</p>
      </div>

      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Physical Sample Kit</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Examine cables, mesh swatches, and track profiles live.</p>
      </div>

      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Immediate Estimates</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Laser-measured dimensions with clear pricing.</p>
      </div>
    </div>

    <!-- Horizontal Auto-Sliding Viewport -->
    <div
      class="relative mt-12 select-none overflow-hidden rounded-3xl"
      id="areas-slider-viewport"
      aria-roledescription="carousel"
      aria-label="Bengaluru Operational Service Zones"
    >
      <div
        id="areas-slider-track"
        class="flex gap-6 will-change-transform"
        style="transform: translateX(0px);"
      >
        {
          extendedAreasData.map((area, index) => {
            const areaNum = (index % serviceAreasData.length) + 1;
            const visual = areaImageCards[area.id] || {
              image: "/images/desktop/invisible-grills.webp",
              whatWeProvide: "Balcony Invisible Grills & Safety Nets",
            };
            const areaWhatsappMsg = getAreaSiteVisitMessage(area.name);
            const areaWhatsappUrl = getWhatsAppUrl(areaWhatsappMsg);

            return (
              <article
                class="area-card group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-lg shrink-0 w-[270px] sm:w-[310px] lg:w-[330px]"
              >
                <div>
                  <!-- Photographic Visual Showing Installed Solution in This Area -->
                  <div class="relative aspect-4/3 w-full overflow-hidden bg-[var(--color-soft-bg)]">
                    <img
                      src={visual.image}
                      alt={`${area.name} — ${visual.whatWeProvide} by MMR Safety`}
                      width="600"
                      height="450"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
                    
                    <!-- Zone & Dispatch Badges -->
                    <span class="absolute top-3 left-3 rounded-full bg-black/60 backdrop-blur-md px-3 py-1 text-[11px] font-semibold text-white/95 border border-white/20 shadow-xs">
                      {area.zone}
                    </span>

                    <span class="absolute top-3 right-3 rounded-full bg-emerald-500/90 backdrop-blur-md px-2.5 py-1 text-[10px] font-bold text-white shadow-xs flex items-center gap-1">
                      <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
                      {area.responseTime}
                    </span>

                    <span class="absolute bottom-3 left-3 text-xs font-bold text-white drop-shadow-md flex items-center gap-1.5">
                      <span class="flex h-2 w-2 rounded-full bg-[var(--color-sky-blue)]"></span>
                      Zone 0{areaNum}
                    </span>
                  </div>

                  <!-- Location & What We Provide (Image Representation, Less Text) -->
                  <div class="p-4 sm:p-5">
                    <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors line-clamp-1">
                      {area.name}
                    </h3>
                    
                    <p class="mt-1 text-xs font-semibold text-[var(--color-sky-blue-dark)] line-clamp-1">
                      {visual.whatWeProvide}
                    </p>
                  </div>
                </div>

                <!-- 1-Click WhatsApp Site Visit CTA -->
                <div class="p-4 sm:p-5 pt-0">
                  <a
                    href={areaWhatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-3.5 py-2.5 text-xs font-bold text-white shadow-xs transition-all hover:bg-[#1EBE5D] hover:shadow-md active:scale-98"
                    aria-label={`Request Free Site Visit in ${area.name} on WhatsApp`}
                  >
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29"/>
                    </svg>
                    <span>Request Free Site Visit</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <!-- Navigation Dots Indicator -->
    <div class="mt-8 flex items-center justify-center gap-2" id="areas-slider-dots">
      {
        serviceAreasData.map((_, i) => (
          <button
            type="button"
            class="area-dot h-2 rounded-full transition-all duration-300"
            data-index={i}
            aria-label={`Go to area slide ${i + 1}`}
          />
        ))
      }
    </div>

    {showContactPrompt && (
      <div class="mt-12 rounded-3xl border border-[var(--color-border)] bg-white p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)]">
            Don&apos;t See Your Specific Apartment Society or Layout Listed?
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-[var(--color-muted-text)]">
            Our installation technicians travel across the entire Greater Bengaluru metropolitan region. Call us directly to verify site visit scheduling for your building.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href={phoneUrl}
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-5 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[var(--color-primary-navy-dark)]"
          >
            <svg class="h-3.5 w-3.5 text-[var(--color-sky-blue)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
            </svg>
            <span>Call {siteConfig.contact.phone}</span>
          </a>
        </div>
      </div>
    )}

  </div>
</section>

<script>
  function initAreasCarousel() {
    const viewport = document.getElementById("areas-slider-viewport");
    const track = document.getElementById("areas-slider-track");
    const prevBtn = document.getElementById("areas-prev-btn");
    const nextBtn = document.getElementById("areas-next-btn");
    const dots = document.querySelectorAll(".area-dot");

    if (!viewport || !track) return;

    const cards = track.querySelectorAll(".area-card");
    const totalOriginalCards = 8;
    if (cards.length === 0) return;

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let isPaused = false;
    let isTransitioning = false;

    function getCardStep(): number {
      if (cards.length > 1) {
        const first = cards[0] as HTMLElement;
        const second = cards[1] as HTMLElement;
        return second.offsetLeft - first.offsetLeft;
      }
      return (cards[0] as HTMLElement).offsetWidth + 24;
    }

    function updateDots() {
      const activeIndex = currentIndex % totalOriginalCards;
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.className = "area-dot h-2 w-7 rounded-full bg-[var(--color-primary-navy)] transition-all duration-300";
        } else {
          dot.className = "area-dot h-2 w-2 rounded-full bg-[var(--color-border)] hover:bg-[var(--color-muted-text)] transition-all duration-300";
        }
      });
    }

    function goToIndex(index: number, animate = true) {
      currentIndex = index;
      const step = getCardStep();
      if (animate) {
        track!.style.transition = "transform 500ms cubic-bezier(0.25, 1, 0.5, 1)";
      } else {
        track!.style.transition = "none";
      }
      track!.style.transform = `translateX(-${currentIndex * step}px)`;
      updateDots();
    }

    function nextSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      goToIndex(currentIndex, true);

      setTimeout(() => {
        if (currentIndex >= totalOriginalCards) {
          currentIndex = 0;
          goToIndex(0, false);
        }
        isTransitioning = false;
      }, 520);
    }

    function prevSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      if (currentIndex <= 0) {
        currentIndex = totalOriginalCards;
        goToIndex(totalOriginalCards, false);
        void track!.offsetHeight;
      }
      currentIndex--;
      goToIndex(currentIndex, true);

      setTimeout(() => {
        isTransitioning = false;
      }, 520);
    }

    function startAutoplay() {
      stopAutoplay();
      // 1-second pause on each slide + 500ms transition = 1500ms cycle
      timer = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, 1500);
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    viewport.addEventListener("mouseenter", () => {
      isPaused = true;
    });
    viewport.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        nextSlide();
        startAutoplay();
      });
    }
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        prevSlide();
        startAutoplay();
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
        goToIndex(idx, true);
        startAutoplay();
      });
    });

    let touchStartX = 0;
    let touchEndX = 0;

    viewport.addEventListener(
      "touchstart",
      (e) => {
        isPaused = true;
        touchStartX = (e as TouchEvent).touches[0].clientX;
      },
      { passive: true }
    );

    viewport.addEventListener(
      "touchend",
      (e) => {
        touchEndX = (e as TouchEvent).changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
        isPaused = false;
        startAutoplay();
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      goToIndex(currentIndex, false);
    });

    goToIndex(0, false);
    startAutoplay();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAreasCarousel);
  } else {
    initAreasCarousel();
  }
</script>
