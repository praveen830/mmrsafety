---
/**
 * ServiceAreasSection.astro — Confirmed Operational Service Zones
 *
 * Driven directly from siteConfig.ts (serviceAreasData).
 * Displays confirmed residential zones across Bengaluru with prompt
 * site-visit dispatch commitments and direct area-specific WhatsApp enquiry triggers.
 */
import {
  serviceAreasData,
  siteConfig,
  getPhoneUrl,
  getWhatsAppUrl,
  getAreaSiteVisitMessage,
} from "@data/siteConfig";

interface Props {
  title?: string;
  subtitle?: string;
  showContactPrompt?: boolean;
}

const {
  title = "Confirmed Service Zones & On-Site Availability Across Bengaluru",
  subtitle = "Our mobile technical vans carry physical samples and laser measurement gear directly to your doorstep. Explore our confirmed operational areas below.",
  showContactPrompt = true,
} = Astro.props;

const phoneUrl = getPhoneUrl();
---

<section
  id="service-areas"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="areas-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Operational Coverage
      </span>
      <h2 id="areas-heading" class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Rapid Dispatch Indicators -->
    <div class="mt-10 mx-auto max-w-4xl grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Same-Day / 24h Visits</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Prompt technician scheduling for all confirmed sectors.</p>
      </div>

      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Physical Sample Kit</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Examine cables, mesh swatches, and track profiles live.</p>
      </div>

      <div class="rounded-2xl border border-[var(--color-border)] bg-white p-4 shadow-xs">
        <span class="flex h-8 w-8 mx-auto items-center justify-center rounded-full bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </span>
        <h3 class="mt-2 text-sm font-bold text-[var(--color-primary-navy)]">Immediate Estimates</h3>
        <p class="text-xs text-[var(--color-muted-text)] mt-0.5">Laser-measured dimensions with clear per-sqft pricing.</p>
      </div>
    </div>

    <!-- 8 Areas Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {serviceAreasData.map((area) => {
        const areaWhatsappMsg = getAreaSiteVisitMessage(area.name);
        const areaWhatsappUrl = getWhatsAppUrl(areaWhatsappMsg);

        return (
          <article class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-lg">
            
            <div>
              <!-- Zone Tag & Dispatch Status -->
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center rounded-md bg-[var(--color-soft-bg)] border border-[var(--color-border-light)] px-2.5 py-0.5 text-[11px] font-bold text-[var(--color-sky-blue-dark)]">
                  {area.zone}
                </span>
                <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  {area.responseTime}
                </span>
              </div>

              <!-- Area Name -->
              <h3 class="mt-3.5 text-base sm:text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                {area.name}
              </h3>

              <p class="mt-2 text-xs text-[var(--color-muted-text)] leading-relaxed">
                {area.description}
              </p>

              <!-- Landmarks Covered -->
              <div class="mt-4">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-primary-navy)]/80">
                  Key Corridors:
                </span>
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {area.landmarks.map((landmark) => (
                    <span class="inline-flex items-center rounded-sm bg-slate-50 border border-slate-200/60 px-1.5 py-0.5 text-[10px] text-[var(--color-muted-text)]">
                      {landmark}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Popular Solutions In Area -->
              <div class="mt-3.5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-primary-navy)]/80">
                  High Demand:
                </span>
                <p class="mt-0.5 text-xs font-semibold text-[var(--color-primary-navy)]">
                  {area.popularServices.join(" • ")}
                </p>
              </div>
            </div>

            <!-- Area CTA -->
            <div class="mt-6 pt-4 border-t border-[var(--color-border-light)]">
              <a
                href={areaWhatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-3.5 py-2.5 text-xs font-bold text-white shadow-xs transition-all hover:bg-[#1EBE5D] hover:shadow-md active:scale-98"
                aria-label={`Request Free Site Visit in ${area.name} on WhatsApp`}
              >
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                </svg>
                <span>Request Visit in This Area</span>
              </a>
            </div>

          </article>
        );
      })}
    </div>

    {showContactPrompt && (
      
      <div class="mt-12 rounded-3xl border border-[var(--color-border)] bg-white p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)]">
            Don&apos;t See Your Specific Apartment Society or Layout Listed?
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-[var(--color-muted-text)]">
            Our installation technicians travel across the entire Greater Bengaluru metropolitan region. Call us directly to verify site visit scheduling for your building.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href={phoneUrl}
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-navy)] px-5 py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[var(--color-primary-navy-dark)]"
          >
            <svg class="h-3.5 w-3.5 text-[var(--color-sky-blue)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
            </svg>
            <span>Call {siteConfig.contact.phone}</span>
          </a>
        </div>
      </div>
    )}

  </div>
</section>
