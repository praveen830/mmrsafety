---
/**
 * SafetyRequirementsSection.astro — Architectural & Functional Safety Requirements
 *
 * 8-Card Photographic Grid presenting verified safety applications:
 * 1. Children Safety
 * 2. Pet Safety (Cats & Dogs)
 * 3. High-Rise Balcony Protection
 * 4. Open Window Protection
 * 5. Pigeon & Bird Hygiene Protection
 * 6. Sports & Turf Facility Enclosures
 * 7. Residential Apartment Complexes
 * 8. Commercial & Industrial Buildings
 */
import { safetyRequirementsData } from "@data/siteConfig";
---

<section
  id="safety-requirements"
  class="bg-white py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="safety-req-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Application Scenarios
      </span>
      <h2
        id="safety-req-heading"
        class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]"
      >
        Safety Requirements &amp; Architectural Applications
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        Engineered protective barriers configured for specific structural requirements across homes, luxury communities, sports grounds, and commercial spaces.
      </p>
    </div>

    <!-- 8 Photographic Requirements Grid -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        safetyRequirementsData.map((req, index) => (
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
            
            <div>
              <!-- Photographic Visual -->
              <div class="relative aspect-16/10 w-full overflow-hidden bg-[var(--color-soft-bg)]">
                <img
                  src={req.image}
                  alt={req.title}
                  width="600"
                  height="375"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                  loading="lazy"
                  decoding="async"
                />
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
                
                <span class="absolute bottom-2.5 left-3 text-[11px] font-bold text-white/95 drop-shadow-md flex items-center gap-1.5">
                  <span class="flex h-1.5 w-1.5 rounded-full bg-[var(--color-sky-blue)]"></span>
                  Scenario 0{index + 1}
                </span>
              </div>

              <!-- Content Body -->
              <div class="p-5">
                <h3 class="text-base font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                  {req.title}
                </h3>
                
                <p class="mt-1 text-xs font-semibold text-[var(--color-sky-blue-dark)]">
                  {req.tagline}
                </p>

                <p class="mt-2.5 text-xs text-[var(--color-muted-text)] leading-relaxed line-clamp-3">
                  {req.description}
                </p>

                <!-- Suitability Tag -->
                <div class="mt-4 border-t border-[var(--color-border-light)] pt-3 text-[11px] text-[var(--color-primary-navy)]/80">
                  <strong class="font-bold block text-[var(--color-primary-navy)] text-[10px] uppercase tracking-wider mb-0.5">
                    Structure Suitability:
                  </strong>
                  <span>{req.suitability}</span>
                </div>
              </div>
            </div>

            <!-- Card Bottom: Link to Recommended Solution -->
            <div class="p-5 pt-0">
              <a
                href={`/services/${req.recommendedSlug}/`}
                class="inline-flex w-full items-center justify-between rounded-xl border border-[var(--color-border-light)] bg-[var(--color-soft-bg)] px-3 py-2 text-xs font-bold text-[var(--color-primary-navy)] transition-colors hover:bg-[var(--color-primary-navy)] hover:text-white"
              >
                <span>{req.recommendedService}</span>
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>
