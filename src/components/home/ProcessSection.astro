---
/**
 * ProcessSection.astro — 4-Step Installation Workflow
 *
 * Visualizes the professional end-to-end installation journey:
 * 1. Consultation & Site Inspection
 * 2. Custom Planning & Material Preparation
 * 3. Professional Installation
 * 4. Tension Testing & Handover
 */
import { processSteps } from "@data/homeData";
---

<section
  id="process"
  class="relative bg-[var(--color-soft-bg)] py-20 lg:py-28 border-b border-[var(--color-border-light)] scroll-mt-16"
  aria-labelledby="process-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Execution Process
      </span>
      <h2 id="process-heading" class="heading-section mt-3 text-3xl sm:text-4xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        From Consultation to Complete Safety in 4 Clear Steps
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
        Our standardized installation process ensures structural precision, clean execution, and lasting peace of mind.
      </p>
    </div>

    <!-- Process Steps Grid with Connecting Line -->
    <div class="relative mt-16">
      
      <!-- Connecting Track (Visible on large screens) -->
      <div
        class="hidden lg:block absolute top-1/2 left-8 right-8 -translate-y-12 h-0.5 bg-gradient-to-r from-[var(--color-primary-navy)] via-[var(--color-sky-blue)] to-[var(--color-primary-navy)] opacity-20 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step, index) => (
            <div class="relative flex flex-col justify-between rounded-2xl border border-[var(--color-border)] bg-white p-6 sm:p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-lg">
              
              <div>
                <!-- Step Badge and Number -->
                <div class="flex items-center justify-between mb-6">
                  <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-primary-navy)] text-base font-extrabold text-white shadow-xs">
                    {step.step}
                  </span>
                  <span class="text-xs font-semibold tracking-wider uppercase text-[var(--color-sky-blue-dark)]">
                    Phase 0{index + 1}
                  </span>
                </div>

                <!-- Title & Description -->
                <h3 class="text-lg font-bold text-[var(--color-primary-navy)]">
                  {step.title}
                </h3>
                <p class="mt-3 text-sm text-[var(--color-muted-text)] leading-relaxed">
                  {step.description}
                </p>
              </div>

              <!-- Key Deliverables Pill -->
              <div class="mt-6 border-t border-[var(--color-border-light)] pt-4">
                <span class="text-[11px] font-medium text-[var(--color-primary-navy)]/80 bg-[var(--color-soft-bg)] px-2.5 py-1 rounded-md block text-center">
                  {step.detail}
                </span>
              </div>

            </div>
          ))
        }
      </div>

    </div>

    <!-- Process Assurance Note -->
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 rounded-xl border border-[var(--color-border)] bg-white p-5 sm:px-8 shadow-xs">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--color-sky-blue)]/15 text-[var(--color-primary-navy)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
        <p class="text-xs sm:text-sm text-[var(--color-muted-text)]">
          <strong class="text-[var(--color-primary-navy)]">Structured execution:</strong> Efficient, dust-controlled installation scheduled once measurements and custom fittings are confirmed.
        </p>
      </div>
      <a
        href="#quote"
        class="shrink-0 text-xs sm:text-sm font-semibold text-[var(--color-sky-blue-dark)] hover:text-[var(--color-primary-navy)] transition-colors inline-flex items-center gap-1"
      >
        <span>Schedule an inspection</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</section>
