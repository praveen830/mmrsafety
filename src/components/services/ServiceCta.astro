---
/**
 * ServiceCta.astro
 *
 * Dedicated bottom conversion section featuring Call Now, Free Site Visit,
 * WhatsApp quick actions, and an honest Free Site Visit request form.
 */
import ServiceContactButtons from "@components/services/ServiceContactButtons.astro";

interface Props {
  name: string;
  slug: string;
}

const { name, slug } = Astro.props;
---

<section id="quote" class="bg-gradient-to-b from-[var(--color-soft-bg)] to-white py-16 lg:py-24 border-b border-[var(--color-border-light)] scroll-mt-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    
    <div class="rounded-3xl border border-[var(--color-border)] bg-white p-8 sm:p-12 shadow-xl">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        
        <!-- Left: Value Prop & Contact Info (5 cols) -->
        <div class="lg:col-span-5">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
            Zero Obligation • 100% Free
          </span>
          
          <h2 class="mt-3 text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
            Request a Free Site Visit &amp; Measurement
          </h2>
          
          <p class="mt-3 text-sm text-[var(--color-muted-text)] leading-relaxed">
            Our expert technicians conduct on-site laser measurements, present physical material samples, and provide transparent upfront pricing across Bengaluru.
          </p>

          <!-- 3 Lead-Generation Action Buttons -->
          <div class="mt-8 space-y-3">
            <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
              Direct Contact Options:
            </p>
            <ServiceContactButtons serviceName={name} size="large" />
          </div>
        </div>

        <!-- Right: Inquiry Form (7 cols) -->
        <div class="lg:col-span-7 bg-[var(--color-soft-bg)] p-6 sm:p-8 rounded-2xl border border-[var(--color-border)]">
          <form id={`cta-form-${slug}`} class="space-y-4">
            <div>
              <label for={`service-name-${slug}`} class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-1">
                Your Full Name *
              </label>
              <input
                type="text"
                id={`service-name-${slug}`}
                name="name"
                required
                placeholder="e.g. Ramesh Kumar"
                class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder-slate-400 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-1 focus:ring-[var(--color-sky-blue)]"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for={`service-phone-${slug}`} class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-1">
                  Phone Number *
                </label>
                <div class="relative flex rounded-xl border border-[var(--color-border)] bg-white focus-within:border-[var(--color-sky-blue)] focus-within:ring-1 focus-within:ring-[var(--color-sky-blue)]">
                  <span class="inline-flex items-center px-3 text-xs font-bold text-gray-500 border-r border-[var(--color-border)]">
                    +91
                  </span>
                  <input
                    type="tel"
                    id={`service-phone-${slug}`}
                    name="phone"
                    required
                    pattern="[0-9]{10}"
                    placeholder="10-digit mobile"
                    class="w-full bg-transparent px-3 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder-slate-400 focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label for={`service-location-${slug}`} class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-1">
                  Apartment / Area *
                </label>
                <input
                  type="text"
                  id={`service-location-${slug}`}
                  name="location"
                  required
                  placeholder="e.g. Whitefield, Bengaluru"
                  class="w-full rounded-xl border border-[var(--color-border)] bg-white px-4 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder-slate-400 focus:border-[var(--color-sky-blue)] focus:outline-none focus:ring-1 focus:ring-[var(--color-sky-blue)]"
                />
              </div>
            </div>

            <div>
              <label for={`service-type-${slug}`} class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)] mb-1">
                Service Requested
              </label>
              <input
                type="text"
                id={`service-type-${slug}`}
                name="service"
                readonly
                value={name}
                class="w-full rounded-xl border border-[var(--color-border)] bg-slate-100 px-4 py-2.5 text-sm font-semibold text-[var(--color-primary-navy)] cursor-not-allowed"
              />
            </div>

            <button
              type="submit"
              class="w-full rounded-full bg-[var(--color-primary-navy)] py-3 px-6 text-sm font-bold text-white shadow-md transition-all hover:bg-[var(--color-primary-navy-dark)] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] cursor-pointer active:scale-98"
            >
              Request a Free Site Visit &amp; Measurement
            </button>
            
            <p class="text-center text-xs text-[var(--color-muted-text)]">
              🔒 We respect your privacy. No spam. A technician will call to confirm a convenient slot.
            </p>
          </form>
        </div>

      </div>
    </div>

  </div>
</section>

<script define:vars={{ slug, serviceName: name }}>
  const form = document.getElementById(`cta-form-${slug}`);
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const nameInput = document.getElementById(`service-name-${slug}`);
      const phoneInput = document.getElementById(`service-phone-${slug}`);
      const locInput = document.getElementById(`service-location-${slug}`);

      const nameVal = nameInput && "value" in nameInput ? nameInput.value.trim() : "";
      const phoneVal = phoneInput && "value" in phoneInput ? phoneInput.value.trim() : "";
      const locVal = locInput && "value" in locInput ? locInput.value.trim() : "";
      
      const text = `Hello MMR Safety, I would like to request a Free Site Visit & Measurement in Bengaluru.\n\n👤 Name: ${nameVal}\n📞 Phone: +91 ${phoneVal}\n📍 Locality/Area: ${locVal}\n🛠️ Service: ${serviceName}\n\nPlease let me know the available time slots for inspection.`;
      const waUrl = `https://wa.me/916304433505?text=${encodeURIComponent(text)}`;
      window.open(waUrl, "_blank");
    });
  }
</script>