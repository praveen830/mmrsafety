---
/**
 * FreeSiteVisitModal.astro
 *
 * Honest, interactive dialog for requesting a free on-site safety measurement.
 * Never claims a visit is already confirmed or booked.
 * Collects Name, Phone, Locality, and Service, and forwards the prefilled request
 * to WhatsApp (+91 6304433505) or triggers a direct phone call.
 */
import { siteConfig, getPhoneUrl } from "@data/siteConfig";

interface Props {
  defaultService?: string;
}

const { defaultService = "Invisible Grills" } = Astro.props;
---

<div
  id="free-site-visit-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 transition-all duration-300"
  role="dialog"
  aria-labelledby="site-visit-modal-title"
  aria-modal="true"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="site-visit-modal-backdrop"
    class="fixed inset-0 bg-[#0d2238]/75 backdrop-blur-sm transition-opacity"
  ></div>

  <!-- Modal Content Box -->
  <div class="relative z-10 w-full max-w-lg overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-6 sm:p-8 shadow-2xl transition-all animate-fade-in-up">
    
    <!-- Close Button -->
    <button
      id="close-site-visit-modal-btn"
      type="button"
      class="absolute top-5 right-5 flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-soft-bg)] text-[var(--color-primary-navy)] transition-colors hover:bg-[var(--color-primary-navy)] hover:text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]"
      aria-label="Close free site visit modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header Badge & Title -->
    <div class="text-left">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Zero Obligation • 100% Free
      </span>
      <h2 id="site-visit-modal-title" class="mt-3 text-2xl font-extrabold text-[var(--color-primary-navy)]">
        Request a Free Site Visit &amp; Measurement
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-[var(--color-muted-text)] leading-relaxed">
        Our technical specialist will visit your property in Bengaluru to inspect your balcony or windows, take accurate laser measurements, and provide honest pricing.
      </p>
    </div>

    <!-- Interactive Form -->
    <form id="free-site-visit-form" class="mt-6 space-y-4">
      
      <!-- Full Name -->
      <div>
        <label for="modal-name" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
          Your Full Name *
        </label>
        <input
          type="text"
          id="modal-name"
          name="name"
          required
          placeholder="e.g. Rahul Sharma"
          class="mt-1.5 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-4 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder:text-gray-400 focus:border-[var(--color-sky-blue)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
        />
      </div>

      <!-- Phone Number -->
      <div>
        <label for="modal-phone" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
          Phone Number *
        </label>
        <div class="relative mt-1.5 flex rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] focus-within:border-[var(--color-sky-blue)] focus-within:bg-white focus-within:ring-2 focus-within:ring-[var(--color-sky-blue)]/20">
          <span class="inline-flex items-center px-3 text-xs font-bold text-gray-500 border-r border-[var(--color-border)]">
            +91
          </span>
          <input
            type="tel"
            id="modal-phone"
            name="phone"
            required
            pattern="[0-9]{10}"
            placeholder="10-digit mobile number"
            class="w-full bg-transparent px-3 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder:text-gray-400 focus:outline-none"
          />
        </div>
      </div>

      <!-- Locality / Area in Bengaluru -->
      <div>
        <label for="modal-locality" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
          Locality / Apartment Society *
        </label>
        <input
          type="text"
          id="modal-locality"
          name="locality"
          required
          placeholder="e.g. Whitefield, HSR Layout, Sobha Dream Acres"
          class="mt-1.5 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-4 py-2.5 text-sm text-[var(--color-primary-navy)] placeholder:text-gray-400 focus:border-[var(--color-sky-blue)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
        />
      </div>

      <!-- Service Selection -->
      <div>
        <label for="modal-service" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-navy)]">
          Service Required *
        </label>
        <select
          id="modal-service"
          name="service"
          class="mt-1.5 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-4 py-2.5 text-sm text-[var(--color-primary-navy)] focus:border-[var(--color-sky-blue)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]/20 transition-all"
        >
          <option value="Invisible Grills" selected={defaultService === "Invisible Grills"}>Invisible Grills (Balconies &amp; Windows)</option>
          <option value="Safety Nets" selected={defaultService === "Safety Nets"}>Safety Nets (Fall Protection)</option>
          <option value="Pigeon Safety Nets" selected={defaultService === "Pigeon Safety Nets"}>Pigeon Safety Nets (Bird Exclusion)</option>
          <option value="Sports Nets" selected={defaultService === "Sports Nets"}>Sports Nets (Cricket &amp; Play Areas)</option>
          <option value="Cloth Hangers" selected={defaultService === "Cloth Hangers"}>Cloth Hangers (Ceiling Pulley Systems)</option>
          <option value="Bird Spikes" selected={defaultService === "Bird Spikes"}>Bird Spikes (Parapets &amp; Ledges)</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="pt-2 space-y-2.5">
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-5 py-3.5 text-sm font-extrabold text-white shadow-md transition-all hover:bg-[#1ebe5d] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#25D366] active:scale-98"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
          </svg>
          <span>Send Site Visit Request on WhatsApp</span>
        </button>

        <a
          href={getPhoneUrl()}
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[var(--color-border)] bg-white px-5 py-3 text-xs font-bold text-[var(--color-primary-navy)] transition-all hover:bg-[var(--color-soft-bg)] hover:border-[var(--color-primary-navy)] active:scale-98"
        >
          <svg class="h-4 w-4 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Or Call Directly: {siteConfig.contact.phone}</span>
        </a>
      </div>

    </form>

    <!-- Trust Footer -->
    <p class="mt-4 text-center text-[11px] text-[var(--color-muted-text)]">
      🔒 We respect your privacy. No spam. A technician will contact you to confirm a convenient slot.
    </p>

  </div>
</div>

<script>
  function initSiteVisitModal() {
    const modal = document.getElementById("free-site-visit-modal");
    const backdrop = document.getElementById("site-visit-modal-backdrop");
    const closeBtn = document.getElementById("close-site-visit-modal-btn");
    const form = document.getElementById("free-site-visit-form") as HTMLFormElement | null;
    const triggerBtns = document.querySelectorAll("[data-open-site-visit-modal]");

    if (!modal) return;

    function openModal(serviceName?: string) {
      if (!modal) return;
      if (serviceName) {
        const select = document.getElementById("modal-service") as HTMLSelectElement | null;
        if (select) {
          const matchOption = Array.from(select.options).find(opt => 
            opt.text.toLowerCase().includes(serviceName.toLowerCase()) || 
            opt.value.toLowerCase().includes(serviceName.toLowerCase())
          );
          if (matchOption) select.value = matchOption.value;
        }
      }
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      const nameInput = document.getElementById("modal-name") as HTMLInputElement | null;
      if (nameInput) setTimeout(() => nameInput.focus(), 100);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    // Attach trigger clicks
    triggerBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const sName = btn.getAttribute("data-service-name") || undefined;
        openModal(sName);
      });
    });

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (backdrop) backdrop.addEventListener("click", closeModal);

    // Escape Key listener
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    // Form Submission: Formats WhatsApp message cleanly
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const name = (document.getElementById("modal-name") as HTMLInputElement)?.value.trim() || "";
        const phone = (document.getElementById("modal-phone") as HTMLInputElement)?.value.trim() || "";
        const locality = (document.getElementById("modal-locality") as HTMLInputElement)?.value.trim() || "";
        const service = (document.getElementById("modal-service") as HTMLSelectElement)?.value || "Invisible Grills";

        const text = `Hello MMR Safety, I would like to request a Free Site Visit & Measurement in Bengaluru.\n\n👤 Name: ${name}\n📞 Phone: +91 ${phone}\n📍 Locality/Society: ${locality}\n🛠️ Service Needed: ${service}\n\nPlease confirm an available inspection time slot.`;
        const waUrl = `https://wa.me/916304433505?text=${encodeURIComponent(text)}`;
        
        window.open(waUrl, "_blank");
        closeModal();
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSiteVisitModal);
  } else {
    initSiteVisitModal();
  }
</script>