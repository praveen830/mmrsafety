---
/**
 * ServiceHero.astro
 *
 * Streamlined service page hero designed for maximum visual clarity and mobile compatibility:
 * - Small clean title & category badge at the top
 * - High-resolution architectural photography below the title
 * - Three primary conversion buttons (Call Now, Free Site Visit, WhatsApp) aligned at the bottom inside the image frame
 */
import {
  getPhoneUrl,
  getWhatsAppUrl,
  getFreeSiteVisitMessage,
  getServiceEnquiryMessage,
} from "@data/siteConfig";

interface Props {
  name: string;
  category: string;
  tagline: string;
  subtitle?: string;
  heroImage?: string;
  imageDesktop?: string;
  imageMobile?: string;
  imageAlt?: string;
  altText?: string;
  specBadges?: string[];
}

const {
  name,
  category,
  tagline,
  heroImage,
  imageDesktop = heroImage || "",
  imageMobile = heroImage || "",
  imageAlt,
  altText,
} = Astro.props;

const resolvedAlt = imageAlt || altText || `${name} Installation by MMR Safety`;
const phoneUrl = getPhoneUrl();
const siteVisitUrl = getWhatsAppUrl(getFreeSiteVisitMessage(name));
const whatsappUrl = getWhatsAppUrl(getServiceEnquiryMessage(name));
---

<section class="relative overflow-hidden bg-gradient-to-b from-[var(--color-soft-bg)] via-white to-white pt-6 pb-10 sm:pt-8 sm:pb-14 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    
    <!-- Top: Small Title & Category -->
    <div class="text-center mb-5 sm:mb-7">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        <span>{category}</span>
      </div>

      <h1 class="mt-2 text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        {name}
      </h1>

      {tagline && (
        <p class="mt-1 text-xs sm:text-sm font-medium text-[var(--color-muted-text)]">
          {tagline}
        </p>
      )}
    </div>

    <!-- Below Title: Image Frame with Buttons inside the frame at the bottom -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-[var(--color-border)] bg-white shadow-xl transition-all">
      <div class="relative aspect-4/5 sm:aspect-16/9 lg:aspect-2/1 w-full overflow-hidden bg-[var(--color-soft-bg)]">
        
        <!-- Architectural Photograph -->
        <picture class="h-full w-full">
          <source media="(min-width: 768px)" srcset={imageDesktop} type="image/webp" />
          <img
            src={imageMobile}
            alt={resolvedAlt}
            width="1200"
            height="675"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-102"
            loading="eager"
            decoding="async"
          />
        </picture>

        <!-- Subtle Top Shadow for contrast -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/25 to-transparent"></div>

        <!-- Buttons Aligned at the Bottom of the Image, Inside Its Frame -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/55 to-transparent pt-14 pb-3 sm:pb-5 px-3 sm:px-6">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-2 sm:gap-3.5 max-w-xl mx-auto">
            
            <!-- 1. Call Now Button -->
            <a
              href={phoneUrl}
              class="inline-flex items-center justify-center gap-2 rounded-full font-bold px-5 py-2.5 sm:py-3 text-xs sm:text-sm bg-[var(--color-primary-navy)] text-white hover:bg-[var(--color-primary-navy-dark)] shadow-md transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]"
              aria-label={`Call MMR Safety directly regarding ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
              </svg>
              <span>Call Now</span>
            </a>

            <!-- 2. Free Site Visit Button (Modal Trigger) -->
            <a
              href={siteVisitUrl}
              data-open-site-visit-modal
              data-service-name={name}
              class="inline-flex items-center justify-center gap-2 rounded-full font-bold px-5 py-2.5 sm:py-3 text-xs sm:text-sm bg-white text-[var(--color-primary-navy)] hover:bg-[var(--color-soft-bg)] shadow-md transition-all active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]"
              aria-label={`Request Free Site Visit for ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Free Site Visit</span>
            </a>

            <!-- 3. WhatsApp Direct Chat Button -->
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full font-bold px-5 py-2.5 sm:py-3 text-xs sm:text-sm bg-[#25D366] text-white hover:bg-[#1EBE5D] shadow-md transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#25D366]"
              aria-label={`Chat on WhatsApp regarding ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
              </svg>
              <span>WhatsApp</span>
            </a>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>
