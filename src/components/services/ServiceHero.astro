---
/**
 * ServiceHero.astro
 *
 * Streamlined service page hero designed for maximum visual clarity and mobile compatibility:
 * - Small clean title & category badge at the top
 * - High-resolution architectural photography below the title
 * - Three primary conversion buttons (Call Now, Free Site Visit, WhatsApp) aligned at the bottom inside the image frame
 */
import {
  getPhoneUrl,
  getWhatsAppUrl,
  getFreeSiteVisitMessage,
  getServiceEnquiryMessage,
} from "@data/siteConfig";

interface Props {
  name: string;
  category: string;
  tagline: string;
  subtitle?: string;
  heroImage?: string;
  imageDesktop?: string;
  imageMobile?: string;
  imageAlt?: string;
  altText?: string;
  specBadges?: string[];
}

const {
  name,
  category,
  tagline,
  heroImage,
  imageDesktop = heroImage || "",
  imageMobile = heroImage || "",
  imageAlt,
  altText,
} = Astro.props;

const resolvedAlt = imageAlt || altText || `${name} Installation by MMR Safety`;
const phoneUrl = getPhoneUrl();
const siteVisitUrl = getWhatsAppUrl(getFreeSiteVisitMessage(name));
const whatsappUrl = getWhatsAppUrl(getServiceEnquiryMessage(name));
---

<section class="relative overflow-hidden bg-gradient-to-b from-[var(--color-soft-bg)] via-white to-white pt-6 pb-10 sm:pt-8 sm:pb-14 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    
    <!-- Top: Small Title & Category -->
    <div class="text-center mb-5 sm:mb-7">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        <span>{category}</span>
      </div>

      <h1 class="mt-2 text-2xl sm:text-3xl md:text-4xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        {name}
      </h1>

      {tagline && (
        <p class="mt-1 text-xs sm:text-sm font-medium text-[var(--color-muted-text)]">
          {tagline}
        </p>
      )}
    </div>

    <!-- Below Title: Image Frame with Buttons inside the frame at the bottom -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-[var(--color-border)] bg-white shadow-xl transition-all">
      <div class="relative aspect-4/5 sm:aspect-16/9 lg:aspect-2/1 w-full overflow-hidden bg-[var(--color-soft-bg)]">
        
        <!-- Architectural Photograph -->
        <picture class="h-full w-full">
          <source media="(min-width: 768px)" srcset={imageDesktop} type="image/webp" />
          <img
            src={imageMobile}
            alt={resolvedAlt}
            width="1200"
            height="675"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-102"
            loading="eager"
            decoding="async"
          />
        </picture>

        <!-- Subtle Top Shadow for contrast -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/25 to-transparent"></div>

        <!-- Buttons Aligned at the Bottom of the Image, Inside Its Frame (Horizontal & Compact on Mobile) -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent pt-8 sm:pt-14 pb-2.5 sm:pb-5 px-2 sm:px-6">
          <div class="flex flex-row items-center justify-center gap-1.5 sm:gap-3.5 max-w-xl mx-auto w-full">
            
            <!-- 1. Call Now Button -->
            <a
              href={phoneUrl}
              class="flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold px-2 sm:px-5 py-2 sm:py-3 text-[10.5px] min-[360px]:text-[11px] sm:text-sm bg-[var(--color-primary-navy)] text-white hover:bg-[var(--color-primary-navy-dark)] shadow-md transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] whitespace-nowrap"
              aria-label={`Call MMR Safety directly regarding ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
              </svg>
              <span>Call Now</span>
            </a>

            <!-- 2. Free Site Visit Button (Modal Trigger) -->
            <a
              href={siteVisitUrl}
              data-open-site-visit-modal
              data-service-name={name}
              class="flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold px-2 sm:px-5 py-2 sm:py-3 text-[10.5px] min-[360px]:text-[11px] sm:text-sm bg-white text-[var(--color-primary-navy)] hover:bg-[var(--color-soft-bg)] shadow-md transition-all active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] whitespace-nowrap"
              aria-label={`Request Free Site Visit for ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Free Site Visit</span>
            </a>

            <!-- 3. WhatsApp Direct Chat Button -->
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold px-2 sm:px-5 py-2 sm:py-3 text-[10.5px] min-[360px]:text-[11px] sm:text-sm bg-[#25D366] text-white hover:bg-[#1EBE5D] shadow-md transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#25D366] whitespace-nowrap"
              aria-label={`Chat on WhatsApp regarding ${name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
              </svg>
              <span>WhatsApp</span>
            </a>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>
