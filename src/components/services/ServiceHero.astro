---
/**
 * ServiceHero.astro
 *
 * Cinematic service page hero with responsive <picture> architectural photography,
 * key spec pills, high-contrast typography, and immediate conversion CTAs.
 */
import ServiceContactButtons from "@components/services/ServiceContactButtons.astro";

interface Props {
  name: string;
  category: string;
  tagline: string;
  subtitle: string;
  heroImage?: string;
  imageDesktop?: string;
  imageMobile?: string;
  imageAlt?: string;
  altText: string;
  specBadges: string[];
}

const {
  name,
  category,
  tagline,
  subtitle,
  heroImage,
  imageDesktop = heroImage || "",
  imageMobile = heroImage || "",
  imageAlt,
  altText,
  specBadges,
} = Astro.props;

const resolvedAlt = imageAlt || altText || `${name} Installation by MMR Safety`;
---

<section class="relative overflow-hidden bg-gradient-to-b from-[var(--color-soft-bg)] via-white to-white py-12 lg:py-20 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      
      <!-- Left Column: Service Details & CTAs (7 cols) -->
      <div class="lg:col-span-7">
        
        <!-- Category Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
          <span>{category}</span>
        </div>

        <!-- Main Service Title & Tagline -->
        <h1 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-primary-navy)] tracking-tight leading-tight">
          {name}
          <span class="block text-xl sm:text-2xl font-bold text-[var(--color-sky-blue-dark)] mt-2">
            {tagline}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-5 text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed">
          {subtitle}
        </p>

        <!-- Spec Badges Grid -->
        <div class="mt-6 flex flex-wrap gap-2.5">
          {specBadges.map((badge) => (
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border-light)] bg-[var(--color-soft-bg)] px-3 py-1.5 text-xs font-semibold text-[var(--color-primary-navy)]">
              <svg class="h-3.5 w-3.5 text-[var(--color-sky-blue)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>{badge}</span>
            </span>
          ))}
        </div>

        <!-- Primary Lead Generation CTAs (Call Now, Free Site Visit, WhatsApp) -->
        <div class="mt-8">
          <ServiceContactButtons serviceName={name} size="large" />
        </div>

      </div>

      <!-- Right Column: Responsive <picture> Architectural Photograph (5 cols) -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-2 shadow-xl">
          <div class="relative aspect-4/5 sm:aspect-4/3 w-full overflow-hidden rounded-2xl bg-[var(--color-soft-bg)]">
            <picture class="h-full w-full">
              <source media="(min-width: 768px)" srcset={imageDesktop} type="image/webp" />
              <img
                src={imageMobile}
                alt={resolvedAlt}
                width="896"
                height="1120"
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
                decoding="async"
              />
            </picture>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
