---
/**
 * ServiceGallery.astro — Installation Gallery with Interactive Lightbox Modal
 *
 * Displays high-resolution completed project photography with zoom hover effects
 * and a full-screen Lightbox modal for detailed inspection.
 */
interface Props {
  name: string;
  gallery: {
    image: string;
    alt: string;
    caption: string;
  }[];
}

const { name, gallery } = Astro.props;
---

<section
  id="service-gallery"
  class="bg-[var(--color-soft-bg)] py-16 lg:py-24 border-b border-[var(--color-border-light)]"
  aria-labelledby="gallery-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)] shadow-xs">
        Project Showcase
      </span>
      <h2
        id="gallery-heading"
        class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)] tracking-tight"
      >
        Recent {name} Installations in Bengaluru
      </h2>
      <p class="mt-4 text-base text-[var(--color-muted-text)] leading-relaxed">
        Click any photograph to inspect our finish quality, cable tensioning alignment, and architectural integration.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {
        gallery.map((item, index) => (
          <div
            class="gallery-item group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-xl cursor-pointer"
            data-gallery-index={index}
            data-img-src={item.image}
            data-img-alt={item.alt}
            data-img-caption={item.caption}
            role="button"
            tabindex="0"
            aria-label={`View full size: ${item.caption}`}
          >
            <!-- Visual Container -->
            <div class="relative aspect-16/10 w-full overflow-hidden bg-[var(--color-soft-bg)]">
              <img
                src={item.image}
                alt={item.alt}
                width="1200"
                height="750"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                loading="lazy"
                decoding="async"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/15 to-transparent"></div>
              
              <!-- Hover Zoom Indicator Icon -->
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/95 text-[var(--color-primary-navy)] shadow-xl backdrop-blur-md transform scale-90 group-hover:scale-100 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </span>
              </div>

              <!-- Caption Tag -->
              <span class="absolute bottom-3 left-3 right-3 text-xs sm:text-sm font-semibold text-white drop-shadow-md truncate">
                {item.caption}
              </span>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>

<!-- Full-Screen Interactive Lightbox Modal -->
<div
  id="gallery-lightbox-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Installation Image Lightbox"
>
  <div
    id="lightbox-backdrop"
    class="fixed inset-0 bg-black/90 backdrop-blur-md transition-opacity"
  ></div>

  <!-- Close Button -->
  <button
    id="lightbox-close-btn"
    type="button"
    class="fixed top-5 right-5 z-20 flex h-11 w-11 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-md hover:bg-white hover:text-[var(--color-primary-navy)] transition-colors focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]"
    aria-label="Close Lightbox"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Lightbox Content Box (4:9 High-Resolution Full View) -->
  <div class="relative z-10 flex flex-col items-center max-w-4xl w-full p-2">
    <div class="relative w-full aspect-[4/9] max-h-[50vh] sm:max-h-[460px] overflow-hidden rounded-2xl bg-slate-950 flex items-center justify-center shadow-2xl border border-white/20">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="h-full w-full object-cover transition-all duration-300"
      />
      <span class="absolute bottom-3 left-4 inline-flex items-center gap-1.5 rounded-full bg-black/65 backdrop-blur-md px-2.5 py-0.5 sm:px-3 sm:py-1 text-[10px] sm:text-xs font-bold border border-white/20 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
        </svg>
        <span>4:9 HD Inspection View</span>
      </span>
    </div>

    <!-- Caption -->
    <p id="lightbox-caption" class="mt-4 text-center text-sm font-semibold text-white/95 max-w-2xl px-4"></p>
  </div>
</div>

<script>
  function initGalleryLightbox() {
    const modal = document.getElementById("gallery-lightbox-modal");
    const backdrop = document.getElementById("lightbox-backdrop");
    const closeBtn = document.getElementById("lightbox-close-btn");
    const imgEl = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const captionEl = document.getElementById("lightbox-caption");
    const items = document.querySelectorAll(".gallery-item");

    if (!modal || !imgEl) return;

    function openLightbox(src: string, alt: string, caption: string) {
      if (!modal || !imgEl) return;
      imgEl.src = src;
      imgEl.alt = alt;
      if (captionEl) captionEl.textContent = caption;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      if (imgEl) imgEl.src = "";
    }

    items.forEach((item) => {
      item.addEventListener("click", () => {
        const src = item.getAttribute("data-img-src") || "";
        const alt = item.getAttribute("data-img-alt") || "";
        const caption = item.getAttribute("data-img-caption") || "";
        openLightbox(src, alt, caption);
      });

      item.addEventListener("keydown", (e: any) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const src = item.getAttribute("data-img-src") || "";
          const alt = item.getAttribute("data-img-alt") || "";
          const caption = item.getAttribute("data-img-caption") || "";
          openLightbox(src, alt, caption);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
    if (backdrop) backdrop.addEventListener("click", closeLightbox);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGalleryLightbox);
  } else {
    initGalleryLightbox();
  }
</script>