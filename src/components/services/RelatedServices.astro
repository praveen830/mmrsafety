---
/**
 * RelatedServices.astro
 *
 * Surfaces 3 complementary services with internal links to strengthen SEO and user discovery.
 */
import { servicesDetailData } from "@data/servicesData";

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

const relatedItems = relatedSlugs
  .map((s) => servicesDetailData[s])
  .filter(Boolean);
---

<section class="bg-white py-16 lg:py-24 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Complementary Solutions
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)]">
        Explore Related Safety Services
      </h2>
      <p class="mt-2 text-sm text-[var(--color-muted-text)]">
        Complete home protection solutions designed for modern living spaces.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {relatedItems.map((item) => (
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-soft-bg)]/40 p-5 shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:bg-white hover:shadow-xl">
          <div>
            <div class="relative aspect-16/10 w-full overflow-hidden rounded-2xl bg-[var(--color-soft-bg)]">
              <img
                src={item.heroImage}
                alt={item.altText}
                width="600"
                height="375"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
                loading="lazy"
                decoding="async"
              />
            </div>
            
            <div class="mt-5">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
                {item.category}
              </span>
              <h3 class="mt-1 text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                {item.name}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-[var(--color-muted-text)] line-clamp-2 leading-relaxed">
                {item.subtitle}
              </p>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[var(--color-border-light)]">
            <a
              href={`/services/${item.slug}`}
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white border border-[var(--color-border)] py-2.5 px-4 text-xs font-bold text-[var(--color-primary-navy)] transition-all hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-sm"
            >
              <span>View {item.name} Details</span>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
