---
/**
 * RelatedServices.astro
 *
 * Surfaces 3 complementary services with internal links to strengthen SEO and user discovery.
 */
import { servicesDetailData } from "@data/servicesData";

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

const relatedItems = relatedSlugs
  .map((s) => servicesDetailData[s])
  .filter(Boolean);
---

<section class="bg-white py-16 lg:py-24 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Complementary Solutions
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)]">
        Explore Related Safety Services
      </h2>
      <p class="mt-2 text-sm text-[var(--color-muted-text)]">
        Complete home protection solutions designed for modern living spaces.
      </p>
    </div>

    <div class="mt-8 sm:mt-12 grid grid-cols-1 gap-6 sm:gap-7 md:grid-cols-3">
      {relatedItems.map((item) => (
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl sm:rounded-3xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
          <a
            href={`/services/${item.slug}/`}
            class="block relative aspect-[4/3] sm:aspect-[16/10] w-full overflow-hidden bg-slate-100 cursor-pointer"
            aria-label={`View ${item.name} Details`}
          >
            <img
              src={item.heroImage}
              alt={item.altText}
              width="600"
              height="400"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              loading="lazy"
              decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent" aria-hidden="true"></div>
          </a>
          
          <div class="p-4 sm:p-5 flex flex-col justify-between flex-1">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
                <a href={`/services/${item.slug}/`} class="hover:underline">
                  {item.name}
                </a>
              </h3>
              <p class="mt-1 text-xs text-[var(--color-muted-text)] font-medium">
                {item.tagline}
              </p>
            </div>

            <div class="mt-4 pt-3.5 border-t border-[var(--color-border-light)]">
              <a
                href={`/services/${item.slug}/`}
                class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-[var(--color-soft-bg)] border border-[var(--color-border)] py-2.5 px-3.5 text-xs font-bold text-[var(--color-primary-navy)] transition-all duration-200 hover:bg-[var(--color-primary-navy)] hover:text-white hover:shadow-sm"
              >
                <span>View Details</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
