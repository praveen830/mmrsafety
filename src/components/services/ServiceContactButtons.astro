---
/**
 * ServiceContactButtons.astro
 *
 * Three primary lead-generation CTA buttons for individual service pages:
 * 1. Call Now (tel: dialer)
 * 2. Free Site Visit (prefilled WhatsApp request)
 * 3. WhatsApp (prefilled service enquiry)
 */
import {
  getPhoneUrl,
  getWhatsAppUrl,
  getFreeSiteVisitMessage,
  getServiceEnquiryMessage,
} from "@data/siteConfig";

interface Props {
  serviceName: string;
  size?: "default" | "large";
}

const { serviceName, size = "default" } = Astro.props;

const phoneUrl = getPhoneUrl();
const siteVisitUrl = getWhatsAppUrl(getFreeSiteVisitMessage(serviceName));
const whatsappUrl = getWhatsAppUrl(getServiceEnquiryMessage(serviceName));

const isLarge = size === "large";
---

<div class="flex flex-row flex-wrap items-center gap-1.5 sm:gap-3 w-full">
  
  <!-- 1. Call Now Button -->
  <a
    href={phoneUrl}
    class:list={[
      "flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] whitespace-nowrap",
      "bg-[var(--color-primary-navy)] text-white hover:bg-[var(--color-primary-navy-dark)] hover:shadow-md",
      isLarge ? "px-2 sm:px-6 py-2 sm:py-3.5 text-[10.5px] min-[360px]:text-[11px] sm:text-sm" : "px-2 sm:px-5 py-1.5 sm:py-2.5 text-[10px] min-[360px]:text-[11px] sm:text-sm"
    ]}
    aria-label={`Call MMR Safety directly regarding ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
    </svg>
    <span>Call Now</span>
  </a>

  <!-- 2. Free Site Visit Button (Interactive Modal trigger with WhatsApp fallback) -->
  <a
    href={siteVisitUrl}
    data-open-site-visit-modal
    data-service-name={serviceName}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] cursor-pointer whitespace-nowrap",
      "border-2 border-[var(--color-sky-blue)] bg-white text-[var(--color-primary-navy)] hover:bg-[var(--color-soft-bg)] hover:border-[var(--color-primary-navy)] hover:shadow-md",
      isLarge ? "px-2 sm:px-6 py-2 sm:py-3.5 text-[10.5px] min-[360px]:text-[11px] sm:text-sm" : "px-2 sm:px-5 py-1.5 sm:py-2.5 text-[10px] min-[360px]:text-[11px] sm:text-sm"
    ]}
    aria-label={`Request Free Site Visit for ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <span>Free Site Visit</span>
  </a>

  <!-- 3. WhatsApp Direct Chat Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "flex-1 sm:flex-initial min-w-0 inline-flex items-center justify-center gap-1 sm:gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#25D366] whitespace-nowrap",
      "bg-[#25D366] text-white hover:bg-[#1EBE5D] hover:shadow-md",
      isLarge ? "px-2 sm:px-6 py-2 sm:py-3.5 text-[10.5px] min-[360px]:text-[11px] sm:text-sm" : "px-2 sm:px-5 py-1.5 sm:py-2.5 text-[10px] min-[360px]:text-[11px] sm:text-sm"
    ]}
    aria-label={`Chat on WhatsApp regarding ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 min-[360px]:h-3.5 min-[360px]:w-3.5 sm:h-4 sm:w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.02 2.57c.12.17 1.75 2.68 4.25 3.76.6.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29" />
    </svg>
    <span>WhatsApp</span>
  </a>

</div>
