---
/**
 * ServiceContactButtons.astro
 *
 * Three primary lead-generation CTA buttons for individual service pages:
 * 1. Call Now (tel: dialer)
 * 2. Free Site Visit (prefilled WhatsApp request)
 * 3. WhatsApp (prefilled service enquiry)
 */
import {
  getPhoneUrl,
  getWhatsAppUrl,
  getFreeSiteVisitMessage,
  getServiceEnquiryMessage,
} from "@data/siteConfig";

interface Props {
  serviceName: string;
  size?: "default" | "large";
}

const { serviceName, size = "default" } = Astro.props;

const phoneUrl = getPhoneUrl();
const siteVisitUrl = getWhatsAppUrl(getFreeSiteVisitMessage(serviceName));
const whatsappUrl = getWhatsAppUrl(getServiceEnquiryMessage(serviceName));

const isLarge = size === "large";
---

<div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 w-full">
  
  <!-- 1. Call Now Button -->
  <a
    href={phoneUrl}
    class:list={[
      "inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)]",
      "bg-[var(--color-primary-navy)] text-white hover:bg-[var(--color-primary-navy-dark)] hover:shadow-md",
      isLarge ? "px-6 py-3.5 text-sm" : "px-5 py-2.5 text-xs sm:text-sm"
    ]}
    aria-label={`Call MMR Safety directly regarding ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
    </svg>
    <span>Call Now</span>
  </a>

  <!-- 2. Free Site Visit Button (Interactive Modal trigger with WhatsApp fallback) -->
  <a
    href={siteVisitUrl}
    data-open-site-visit-modal
    data-service-name={serviceName}
    class:list={[
      "inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[var(--color-sky-blue)] cursor-pointer",
      "border-2 border-[var(--color-sky-blue)] bg-white text-[var(--color-primary-navy)] hover:bg-[var(--color-soft-bg)] hover:border-[var(--color-primary-navy)] hover:shadow-md",
      isLarge ? "px-6 py-3.5 text-sm" : "px-5 py-2.5 text-xs sm:text-sm"
    ]}
    aria-label={`Request Free Site Visit for ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[var(--color-sky-blue-dark)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <span>Free Site Visit</span>
  </a>

  <!-- 3. WhatsApp Direct Chat Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all shadow-xs active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#25D366]",
      "bg-[#25D366] text-white hover:bg-[#1EBE5D] hover:shadow-md",
      isLarge ? "px-6 py-3.5 text-sm" : "px-5 py-2.5 text-xs sm:text-sm"
    ]}
    aria-label={`Chat on WhatsApp regarding ${serviceName}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z" />
    </svg>
    <span>WhatsApp</span>
  </a>

</div>
