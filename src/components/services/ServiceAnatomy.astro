---
/**
 * ServiceAnatomy.astro
 *
 * Detailed visual explanation of how the service works and its hardware components.
 */
interface Props {
  anatomy: {
    title: string;
    description: string;
    detailImage: string;
    detailImageAlt: string;
    components: {
      name: string;
      desc: string;
    }[];
  };
}

const { anatomy } = Astro.props;
---

<section class="bg-[var(--color-soft-bg)] py-16 lg:py-24 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="grid items-center gap-12 lg:grid-cols-12">
      
      <!-- Left: Macro Hardware Close-Up (5 cols) -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white p-3 shadow-lg">
          <div class="relative aspect-4/3 w-full overflow-hidden rounded-2xl bg-white">
            <img
              src={anatomy.detailImage}
              alt={anatomy.detailImageAlt}
              width="800"
              height="600"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="mt-3 text-center text-xs font-semibold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
            Precision Hardware &amp; Material Close-Up
          </p>
        </div>
      </div>

      <!-- Right: Technical Breakdown (7 cols) -->
      <div class="lg:col-span-7 order-1 lg:order-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
          Technical Breakdown
        </span>
        
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
          {anatomy.title}
        </h2>
        
        <p class="mt-3 text-base text-[var(--color-muted-text)] leading-relaxed">
          {anatomy.description}
        </p>

        <!-- Components List -->
        <div class="mt-8 space-y-4">
          {anatomy.components.map((comp, idx) => (
            <div class="rounded-xl border border-[var(--color-border)] bg-white p-4 shadow-xs transition-shadow hover:shadow-md">
              <div class="flex items-start gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-sky-blue)]/20 text-xs font-bold text-[var(--color-primary-navy)] mt-0.5">
                  {idx + 1}
                </span>
                <div>
                  <h3 class="text-sm sm:text-base font-bold text-[var(--color-primary-navy)]">
                    {comp.name}
                  </h3>
                  <p class="mt-1 text-xs sm:text-sm text-[var(--color-muted-text)] leading-relaxed">
                    {comp.desc}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>
