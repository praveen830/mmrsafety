---
/**
 * ServiceFaq.astro
 *
 * Accessible FAQ accordion specific to this service with Schema.org FAQPage JSON-LD.
 */
interface Props {
  name: string;
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { name, faqs } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section class="bg-white py-16 lg:py-24 border-b border-[var(--color-border-light)]" aria-labelledby="service-faq-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Frequently Asked Questions
      </span>
      <h2 id="service-faq-heading" class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        Everything You Need to Know About {name}
      </h2>
      <p class="mt-3 text-base text-[var(--color-muted-text)] leading-relaxed">
        Common questions regarding safety, materials, weather endurance, and maintenance.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="mt-12 space-y-4">
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-soft-bg)]/40 p-5 transition-all open:bg-white open:shadow-md hover:border-[var(--color-sky-blue)]">
          <summary class="flex cursor-pointer items-center justify-between font-bold text-base text-[var(--color-primary-navy)] focus:outline-none">
            <span>{faq.question}</span>
            <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white border border-[var(--color-border)] text-[var(--color-primary-navy)] transition-transform duration-300 group-open:rotate-180">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-[var(--color-border-light)] text-sm text-[var(--color-muted-text)] leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

  </div>

  <!-- Injected FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
