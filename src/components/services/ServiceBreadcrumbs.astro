---
/**
 * ServiceBreadcrumbs.astro
 *
 * Accessible breadcrumb navigation with Schema.org BreadcrumbList microdata.
 */
interface Props {
  currentName: string;
  currentSlug: string;
}

const { currentName, currentSlug } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-[var(--color-soft-bg)] border-b border-[var(--color-border-light)] py-3">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ol class="flex items-center space-x-2 text-xs sm:text-sm text-[var(--color-muted-text)]" itemscope itemtype="https://schema.org/BreadcrumbList">
      
      <!-- Home -->
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center">
        <a href="/" class="hover:text-[var(--color-primary-navy)] transition-colors" itemprop="item">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1" />
        <svg class="h-3 w-3 text-slate-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>

      <!-- Services -->
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center">
        <a href="/services" class="hover:text-[var(--color-primary-navy)] transition-colors" itemprop="item">
          <span itemprop="name">Services</span>
        </a>
        <meta itemprop="position" content="2" />
        <svg class="h-3 w-3 text-slate-400 mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </li>

      <!-- Current Service -->
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="flex items-center text-[var(--color-primary-navy)] font-semibold" aria-current="page">
        <span itemprop="name">{currentName}</span>
        <meta itemprop="item" content={`https://mmrsafety.in/services/${currentSlug}/`} />
        <meta itemprop="position" content="3" />
      </li>

    </ol>
  </div>
</nav>
