---
/**
 * ServiceBenefits.astro
 *
 * Photographic Feature & Benefit Cards.
 * Highlights 6 specific functional benefits with photorealistic installation imagery,
 * crisp architectural badges, and informative technical copy.
 */
interface Props {
  name: string;
  overview: string[];
  benefits: {
    title: string;
    description: string;
    icon: string;
    image: string;
  }[];
}

const { name, overview, benefits } = Astro.props;
---

<section class="bg-white py-16 lg:py-24 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Overview -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Engineered Advantages
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        Why Choose {name} for Your Home
      </h2>
      <div class="mt-4 space-y-3 text-base text-[var(--color-muted-text)] leading-relaxed text-left sm:text-center">
        {overview.map((para) => (
          <p>{para}</p>
        ))}
      </div>
    </div>

    <!-- 6 Photographic Benefits Grid -->
    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((item, index) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
          
          <!-- Photographic Visual Showcase -->
          <div class="relative aspect-16/10 w-full overflow-hidden bg-[var(--color-soft-bg)]">
            <img
              src={item.image}
              alt={item.title}
              width="800"
              height="520"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              loading="lazy"
              decoding="async"
            />
            
            <!-- Soft gradient and light glass specular overlay -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
            
            <!-- Advantage Pill Badge -->
            <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 backdrop-blur-md px-3 py-1 text-xs font-bold text-[var(--color-primary-navy)] shadow-md border border-white/60">
              <span class="flex h-1.5 w-1.5 rounded-full bg-[var(--color-sky-blue)]"></span>
              Advantage 0{index + 1}
            </span>
          </div>

          <!-- Card Content Body -->
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
              {item.title}
            </h3>
            
            <p class="mt-2.5 text-sm text-[var(--color-muted-text)] leading-relaxed flex-1">
              {item.description}
            </p>

            <!-- Quality Assurance Verification Pill -->
            <div class="mt-5 flex items-center gap-2 border-t border-[var(--color-border-light)] pt-3.5 text-xs font-medium text-[var(--color-primary-navy)]/80">
              <svg class="h-4 w-4 text-[var(--color-sky-blue-dark)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Verified MMR Installation Standard</span>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
