---
/**
 * ServiceBenefits.astro
 *
 * Streamlined Photographic Feature & Benefit Cards.
 * Highlights key functional benefits with photorealistic installation imagery,
 * crisp architectural badges, and concise copy.
 */
interface Props {
  name: string;
  overview?: string[];
  benefits: {
    title: string;
    description: string;
    icon: string;
    image: string;
  }[];
}

const { name, benefits } = Astro.props;
---

<section class="bg-white py-12 lg:py-16 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center mb-10">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-soft-bg)] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Key Advantages
      </span>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-[var(--color-primary-navy)] tracking-tight">
        Why Choose {name}
      </h2>
    </div>

    <!-- 6 Photographic Benefits Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {benefits.map((item, index) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-sky-blue)] hover:shadow-xl">
          
          <!-- Photographic Visual Showcase -->
          <div class="relative aspect-16/10 w-full overflow-hidden bg-[var(--color-soft-bg)]">
            <img
              src={item.image}
              alt={item.title}
              width="800"
              height="520"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              loading="lazy"
              decoding="async"
            />
            
            <!-- Soft gradient and light glass specular overlay -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
            
            <!-- Advantage Number Badge -->
            <span class="absolute top-3 right-3 rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-bold text-[var(--color-primary-navy)] backdrop-blur-md shadow-xs">
              0{index + 1}
            </span>
          </div>

          <!-- Content Block -->
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <h3 class="text-lg font-bold text-[var(--color-primary-navy)] group-hover:text-[var(--color-sky-blue-dark)] transition-colors">
              {item.title}
            </h3>
            <p class="mt-2 text-sm text-[var(--color-muted-text)] leading-relaxed">
              {item.description}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
