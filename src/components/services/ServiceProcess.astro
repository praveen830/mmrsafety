---
/**
 * ServiceProcess.astro
 *
 * Simple 4-step consultation and installation process.
 */
interface Props {
  name: string;
  process: {
    step: string;
    title: string;
    desc: string;
  }[];
}

const { name, process } = Astro.props;
---

<section class="bg-[var(--color-soft-bg)] py-16 lg:py-24 border-b border-[var(--color-border-light)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-white px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-sky-blue-dark)]">
        Structured Workflow
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--color-primary-navy)]">
        Our 4-Step {name} Installation Process
      </h2>
      <p class="mt-3 text-base text-[var(--color-muted-text)] leading-relaxed">
        From initial site survey to final tension calibration, every step follows strict quality standards.
      </p>
    </div>

    <!-- 4-Step Process Grid -->
    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {process.map((step) => (
        <div class="relative rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-xs transition-all hover:shadow-lg hover:border-[var(--color-sky-blue)]">
          <div class="text-3xl font-black text-[var(--color-sky-blue)]/50 tracking-tighter">
            {step.step}
          </div>
          <h3 class="mt-3 text-lg font-bold text-[var(--color-primary-navy)]">
            {step.title}
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-[var(--color-muted-text)] leading-relaxed">
            {step.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
