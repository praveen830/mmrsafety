---
/**
 * PageLayout.astro
 *
 * Standard page layout with Header and Footer.
 * Wraps BaseLayout and adds the shared page chrome.
 */
import BaseLayout from "./BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import FloatingContactButtons from "@components/layout/FloatingContactButtons.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const { ...seoProps } = Astro.props;
---

<BaseLayout {...seoProps}>
  <slot name="head" slot="head" />

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <!-- Permanent Floating Quick Action Buttons (Call on Bottom-Left, WhatsApp on Bottom-Right) -->
  <FloatingContactButtons />
</BaseLayout>
